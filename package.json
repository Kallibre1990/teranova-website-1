{
  "name": "teranova-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/check-new-locales.mjs --public-only && node scripts/check-translator-notes.mjs && node scripts/check-confidential-prices.mjs",
    "build": "astro build",
    "postbuild": "node scripts/verify-home-locale.mjs",
    "check:new-locales": "node scripts/check-new-locales.mjs --release",
    "check:translator-notes": "node scripts/check-translator-notes.mjs",
    "check:i18n-dist": "node scripts/verify-i18n-dist.mjs",
    "test:i18n": "node scripts/test-locale-policy.mjs && node scripts/test-dist-verifier.mjs && node scripts/test-home-locale.mjs && node scripts/test-catalog-copy.mjs",
    "check:home-locale": "node scripts/verify-home-locale.mjs",
    "release:main": "node scripts/release-main.mjs",
    "test:release": "node scripts/test-release-main.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "^5.3.0",
    "astro": "^6.4.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
