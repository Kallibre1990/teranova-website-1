---
/* Dr.Papirub — brand profile of Two Tigers Corp, split out of the combined
   two-tigers profile on 27.11.2026 (T-20261127-021). */
import Base from '../../layouts/Base.astro';
import SupplierProfile from '../../components/pages/SupplierProfile.astro';
import { supplierBySlug, supplierContent } from '../../data/suppliers';
import { supplierJsonLd } from '../../data/jsonld';

const lang = 'ru' as const;
const profile = supplierBySlug('dr-papirub')!;
const c = supplierContent(profile, lang);
const jsonLd = supplierJsonLd(lang, profile);
---

<Base lang={lang} path={`/catalog/${profile.slug}`} title={c.seoTitle} description={c.seoDesc} image={profile.catalog![0].items[0].img} jsonLd={jsonLd}>
  <SupplierProfile lang={lang} profile={profile} />
</Base>
