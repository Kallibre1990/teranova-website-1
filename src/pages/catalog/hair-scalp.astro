---
/* Подборка «Волосы и кожа головы» — локаль по умолчанию (ru).
   Статический маршрут: [key].astro генерирует только семь категорий,
   пересечения нет. */
import Base from '../../layouts/Base.astro';
import HairScalp from '../../components/pages/HairScalp.astro';
import { ui } from '../../i18n/ui';
import { breadcrumbJsonLd } from '../../data/jsonld';

const lang = 'ru' as const;
const p = ui[lang].pages.hairscalp;
---

<Base
  lang={lang}
  path="/catalog/hair-scalp"
  title={p.seo_title}
  description={p.seo_desc}
  image="/brand/og-cat-hair-scalp.png"
  jsonLd={breadcrumbJsonLd(lang, { key: 'hair-scalp', name: p.title })}
>
  <HairScalp lang={lang} />
</Base>
