---
/* Localized Two Tigers Corp brand-family hub. See catalog/two-tigers.astro
   for why this is a hub, not a profile with its own catalog (T-20261127-042). */
import Base from '../../../layouts/Base.astro';
import TwoTigersHub from '../../../components/pages/TwoTigersHub.astro';
import { supplierBySlug, supplierContent } from '../../../data/suppliers';
import { site } from '../../../data/site';
import { localizePath } from '../../../i18n/utils';
import { defaultLang, languages, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter((l) => l !== defaultLang)
    .map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const profile = supplierBySlug('two-tigers')!;
const c = supplierContent(profile, lang);
const url = site.domain + localizePath(`/catalog/${profile.slug}`, lang);
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: profile.name,
  url,
  description: c.descriptor,
}];
---

<Base lang={lang} path={`/catalog/${profile.slug}`} title="Two Tigers Corp — Wati for Skin & Dr.Papirub · Teranova" description={c.descriptor} image={`/brand/og-${profile.slug}.png`} jsonLd={jsonLd} noindex={true}>
  <TwoTigersHub lang={lang} />
</Base>
