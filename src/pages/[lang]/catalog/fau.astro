---
/* Профиль поставщика: fau — профессиональная сторона FAU CO., LTD.
   Публикуется по письменному разрешению компании от 04.09.2026. Экспортный
   прайс не публикуется: вопрос о публикации задан компании, решение за ней. */
import Base from '../../../layouts/Base.astro';
import SupplierProfile from '../../../components/pages/SupplierProfile.astro';
import { supplierBySlug, supplierContent } from '../../../data/suppliers';
import { supplierJsonLd } from '../../../data/jsonld';
import { defaultLang, languages, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter((l) => l !== defaultLang)
    .map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const profile = supplierBySlug('fau')!;
const c = supplierContent(profile, lang);
const jsonLd = supplierJsonLd(lang, profile);
---

<Base lang={lang} path={`/catalog/${profile.slug}`} title={c.seoTitle} description={c.seoDesc} image={`/brand/og-${profile.slug}.png`} jsonLd={jsonLd}>
  <SupplierProfile lang={lang} profile={profile} />
</Base>
