---
import Base from '../../../layouts/Base.astro';
import SupplierProfile from '../../../components/pages/ToneverProfile.astro';
import { supplierBySlug, supplierContent } from '../../../data/suppliers';
import { supplierJsonLd } from '../../../data/jsonld';
import { publicLocaleCodes } from '../../../i18n/locale-policy.mjs';
import type { Lang } from '../../../i18n/ui';
export function getStaticPaths() { return publicLocaleCodes.filter((lang) => lang !== 'ru').map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const profile = supplierBySlug('tonever')!;
const c = supplierContent(profile, lang);
---
<Base lang={lang} path="/catalog/tonever" title={c.seoTitle} description={c.seoDesc} image="/img/suppliers/tonever/the-pamin.png" jsonLd={supplierJsonLd(lang, profile)}>
  <SupplierProfile lang={lang} profile={profile} />
</Base>
