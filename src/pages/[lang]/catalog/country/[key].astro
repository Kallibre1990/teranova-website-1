---
/* Каталог по стране производства (остальные локали). */
import Base from '../../../../layouts/Base.astro';
import CountryPage from '../../../../components/pages/CountryPage.astro';
import { ui, defaultLang, languages, type Lang } from '../../../../i18n/ui';
import { countryKeys, type CountryKey } from '../../../../data/site';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter((l) => l !== defaultLang)
    .flatMap((lang) => countryKeys.map((key) => ({ params: { lang, key }, props: { lang, key } })));
}

const { lang, key } = Astro.props as { lang: Lang; key: CountryKey };
const t = ui[lang];
const meta = t.countries.list.find((c) => c.key === key)!;
---

<Base lang={lang} path={`/catalog/country/${key}`} title={`${meta.name} · ${t.countries.title} · Teranova`} description={meta.blurb}>
  <CountryPage lang={lang} country={key} />
</Base>
