---
/* SANTE product-line pages — non-default locales. */
import Base from '../../../../layouts/Base.astro';
import SupplierLinePage from '../../../../components/pages/SupplierLinePage.astro';
import { linePages, linePageContent, type SupplierLinePage as SLP } from '../../../../data/suppliers';
import { supplierLineJsonLd } from '../../../../data/jsonld';
import { defaultLang, languages, type Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter((l) => l !== defaultLang)
    .flatMap((lang) => linePages.filter((p) => p.supplierSlug === 'sante').map((p) => ({ params: { lang, line: p.slug }, props: { lang, page: p } })));
}

const { lang, page } = Astro.props as { lang: Lang; page: SLP };
const c = linePageContent(page, lang);
---

<Base lang={lang} path={`/catalog/sante/${page.slug}`} title={c.seoTitle} description={c.seoDesc} jsonLd={supplierLineJsonLd(lang, page)}>
  <SupplierLinePage lang={lang} page={page} />
</Base>
