---
/* Blog index — non-default locales. */
import Base from '../../../layouts/Base.astro';
import BlogIndex from '../../../components/pages/BlogIndex.astro';
import { ui, defaultLang, languages, type Lang } from '../../../i18n/ui';
import { blogJsonLd } from '../../../data/jsonld';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).filter((l) => l !== defaultLang).map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const p = ui[lang].pages.blog;
---

<Base lang={lang} path="/blog" title={`${p.title} — Teranova Group`} description={p.sub} jsonLd={blogJsonLd(lang)}>
  <BlogIndex lang={lang} />
</Base>
