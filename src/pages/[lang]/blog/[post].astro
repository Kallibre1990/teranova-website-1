---
/* Blog article — non-default locales. */
import Base from '../../../layouts/Base.astro';
import BlogPostView from '../../../components/pages/BlogPost.astro';
import { posts, postContent, type BlogPost } from '../../../data/blog';
import { blogPostJsonLd } from '../../../data/jsonld';
import { defaultLang, languages, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter((l) => l !== defaultLang)
    .flatMap((lang) => posts.map((post) => ({ params: { lang, post: post.slug }, props: { lang, post } })));
}

const { lang, post } = Astro.props as { lang: Lang; post: BlogPost };
const c = postContent(post, lang);
---

<Base
  lang={lang}
  path={`/blog/${post.slug}`}
  title={c.seoTitle}
  description={c.seoDesc}
  image={`/brand/og-blog-${post.slug}.png`}
  jsonLd={blogPostJsonLd(lang, post)}
  ogType="article"
  articlePublished={post.date}
  articleModified={post.date}
>
  <BlogPostView lang={lang} post={post} />
</Base>
