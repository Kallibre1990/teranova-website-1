---

import { exsoluContent, type ExsoluLocale, type ExsoluView } from '../../data/exsolu';
import { exsoluPosts } from '../../data/blog-exsolu';
import { localizePath } from '../../i18n/utils';
import { storefront, rejectedProductImages } from '../../data/exsolu-storefront';
interface Props { lang: ExsoluLocale; view: ExsoluView }
const { lang, view } = Astro.props;
const c = exsoluContent(lang);
const ui = storefront[lang];
const link = (slug: string) => localizePath('/catalog/exsolu/' + slug, lang);
const ranges = [
  { slug: 'skin-boosters', title: c.professionalTitle, intro: c.professional, products: c.boosters },
  { slug: 'skincare', title: c.skincare, intro: c.daily, products: c.skincareProducts },
];
const company = view === 'company';
const products = view === 'skin-boosters' ? c.boosters : c.skincareProducts;
---

<article class="exsolu">
  <header class="hero">
    <div>
      <p class="brand">EXSOLU · NOVAMEDINTL</p>
      <h1>{company ? c.company : view === 'skin-boosters' ? c.professionalTitle : c.skincare}</h1>
      <p class="intro">{company ? c.about : view === 'skin-boosters' ? c.professional : c.daily}</p>
      {company ? <div class="range-links">{ranges.map(range => <a href={link(range.slug)}>{range.title}<span>{range.products.length} {ui.products} →</span></a>)}</div> : <a href="#products">{ui.catalogue} · {products.length} {ui.products} ↓</a>}
    </div>
    <figure class="hero-image"><img src={company || view === 'skincare' ? c.skincareProducts[1].image : c.boosters[0].image} alt={company || view === 'skincare' ? c.skincareProducts[1].name : c.boosters[0].name} fetchpriority="high" decoding="async" /></figure>
  </header>
  {company ? <>
    <p class="story">{c.story}</p>
    <div class="ranges">{ranges.map(range => <section class="range" id={range.slug}>
      <a class="range-visual" href={link(range.slug)}><img src={range.products.find(product => !rejectedProductImages.has(product.id))!.image} alt={range.products.find(product => !rejectedProductImages.has(product.id))!.name} loading="lazy" decoding="async" /></a>
      <div class="range-copy"><p class="count">{range.products.length} {ui.products}</p><h2><a href={link(range.slug)}>{range.title}</a></h2><p>{range.intro}</p><a href={link(range.slug)}>{ui.explore} →</a></div>
      <div class="previews">{range.products.filter(product => !rejectedProductImages.has(product.id)).slice(0, 3).map(product => <a class="preview" href={link(range.slug) + '#' + product.id}>
        <figure><img src={product.image} alt={product.name} loading="lazy" decoding="async" /></figure><h3>{product.name}</h3><p>{product.description}</p>
      </a>)}</div>
    </section>)}</div>
    <section class="articles" aria-labelledby="articles-title"><h2 id="articles-title">{ui.articles}</h2><div class="article-grid">{exsoluPosts.map(post => {
      const text = post.i18n[lang];
      if (!text) throw Error(`EXSOLU article translation missing: ${lang}/${post.slug}`);
      return <a class="article-card" href={localizePath('/blog/' + post.slug, lang)}><figure><img src={post.hero} alt="" loading="lazy" decoding="async" /></figure><h3>{text.title}</h3></a>;
    })}</div></section>
  </> : <>
    <p class="note">{c.attribution}</p>
    <p class="note">{c.compositionNote}</p>
    <h2 id="products">{ui.catalogue} · {products.length}</h2>
    <div class="products">
      {products.map((product) => <section class="product" id={product.id}>
        <figure class:list={{ 'photo-pending': rejectedProductImages.has(product.id) }}>{rejectedProductImages.has(product.id) ? <span>{ui.unavailable}</span> : <img src={product.image} alt={product.name} loading="lazy" decoding="async" />}</figure>
        <div>
          <h3>{product.name}</h3>
          <p>{product.description}</p>
          <dl>
            {product.ingredients && <><dt>{c.ingredients}</dt><dd>{product.ingredients}</dd></>}
            <dt>{c.pack}</dt><dd>{product.pack}</dd>
          </dl>
          {product.caution && <p class="caution">{product.caution}</p>}
        </div>
      </section>)}
    </div>
  </>}
  <aside><p>{view === 'skincare' ? c.notice : c.caution}</p></aside>
</article>

<style>
  .exsolu, .exsolu * { box-sizing: border-box; }
  .exsolu { max-width: 1200px; margin: auto; padding: 48px 32px 72px; overflow-wrap: anywhere; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); align-items: center; gap: 56px; padding-block: 24px 56px; }
  .brand { font-size: .8rem; letter-spacing: .08em; font-weight: 650; }
  h1 { font-size: clamp(2rem, 4.5vw, 3.75rem); line-height: 1.12; letter-spacing: -.025em; margin: 20px 0 24px; }
  h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.2; letter-spacing: -.02em; }
  h3 { font-size: 1.15rem; line-height: 1.4; }
  p, dd { line-height: 1.7; max-width: 70ch; }
  .intro { font-size: 1.1rem; }
  a { color: inherit; text-underline-offset: .25em; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .range-links { display: grid; gap: 16px; margin-top: 32px; }
  .range-links a { display: flex; flex-wrap: wrap; gap: 8px 20px; justify-content: space-between; padding-block: 14px; border-bottom: 1px solid var(--line, #d8d3ca); text-decoration: none; }
  .range-links span, .count { font-weight: 650; }
  figure { margin: 0; display: flex; align-items: center; justify-content: center; min-width: 0; background: #fff; }
  img { display: block; max-width: 100%; width: auto; height: auto; object-fit: contain; }
  .hero-image { padding: 16px; height: 256px; }
  .hero-image img { max-height: 224px; }
  .story { padding-block: 32px; font-size: 1.15rem; }
  .ranges { display: grid; gap: 72px; }
  .range { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 32px 56px; border-top: 1px solid var(--line, #d8d3ca); padding-top: 40px; }
  .range-visual { display: flex; justify-content: center; align-items: center; background: white; height: 224px; padding: 16px; }
  .range-visual img { max-height: 192px; }
  .range-copy { align-self: center; }
  .range-copy h2 a { text-decoration: none; }
  .previews { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .preview { text-decoration: none; }
  .preview figure { height: 168px; padding: 12px; }
  .preview img { max-height: 144px; }
  .preview p { font-size: .95rem; }
  .products { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 28px; }
  .product { min-width: 0; border-top: 1px solid var(--line, #d8d3ca); padding-top: 24px; scroll-margin-top: 100px; }
  .product > div { min-width: 0; }
  .product figure { height: 172px; padding: 16px; }
  .product img { max-height: 140px; }
  dt { font-weight: 650; margin-top: 16px; } dd { margin: 4px 0 0; }
  .note { font-size: .95rem; }
  .photo-pending { border: 1px solid var(--line, #d8d3ca); background: transparent; color: #58554f; text-align: center; }
  .articles { margin-top: 72px; padding-top: 32px; border-top: 1px solid var(--line, #d8d3ca); }
  .article-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .article-card { text-decoration: none; }
  .article-card figure { height: 160px; padding: 12px; }
  .article-card img { max-height: 136px; }
  aside { border-top: 1px solid var(--line, #d8d3ca); margin-top: 56px; padding-top: 24px; }
  .caution { font-weight: 650; }
  @media (max-width: 900px) { .products { grid-template-columns: repeat(2, minmax(0, 1fr)); } .hero, .range { gap: 28px; } }
  @media (max-width: 640px) {
    .exsolu { padding: 32px 20px 48px; }
    .hero, .range { grid-template-columns: minmax(0, 1fr); }
    .hero { padding-top: 0; }
    .hero-image { height: 208px; }
    .hero-image img { max-height: 176px; }
    .products, .previews, .article-grid { grid-template-columns: minmax(0, 1fr); }
    .range-visual { height: 192px; }
    .range-visual img { max-height: 160px; }
    .story { padding-top: 0; }
    .ranges { gap: 48px; }
  }
</style>
