---
/* Содержимое раздела Solar Care. Разметка одна, тексты приходят параметром,
   поэтому русская и английская страницы не могут разъехаться по структуре. */
import SolarCareForm from './SolarCareForm.astro';
import type { SolarCopy, SolarLang } from '../../data/solar-care';

interface Props {
  lang: SolarLang;
  copy: SolarCopy;
}
const { lang, copy } = Astro.props;

/* Кейсы производителя техники: подписи приходят из текстов раздела, порядок
   строго тот же, что у подписей. */
const clips = [
  { src: '/video/multifit/case-malaysia.mp4', poster: '/video/multifit/case-malaysia.jpg' },
  { src: '/video/multifit/case-pakistan.mp4', poster: '/video/multifit/case-pakistan.jpg' },
  { src: '/video/multifit/case-usa.mp4', poster: '/video/multifit/case-usa.jpg' },
];

const shots = [
  '/img/suppliers/multifit/gallery/g2-desert-array.jpg',
  '/img/suppliers/multifit/gallery/brush-d-operator.jpg',
  '/img/suppliers/multifit/gallery/robot-rooftop-array.jpg',
];
---

<section class="solar__hero">
  <div class="solar__hero-media">
    {/* Кадр стоит первым: он показывается сразу, пока грузится ролик, и остаётся
        единственным фоном, если человек просил систему не проигрывать анимацию
        или браузер отказал в автозапуске. */}
    <video
      class="solar__hero-video"
      poster="/video/solar-care/hero-array.jpg"
      muted
      loop
      playsinline
      autoplay
      preload="none"
      aria-hidden="true"
      data-src-lg="/video/solar-care/hero-array.mp4"
      data-src-sm="/video/solar-care/hero-array-sm.mp4"></video>
  </div>
  <div class="solar__hero-inner">
    <p class="solar__kicker">{copy.hero.kicker}</p>
    <h1>{copy.hero.title}</h1>
    <p class="solar__lead">{copy.hero.lead}</p>
    <a class="solar__btn" href="#request">{copy.hero.cta}</a>
  </div>
</section>

<section class="solar__section">
  <div class="solar__wrap solar__prose">
    <h2>{copy.intro.title}</h2>
    {copy.intro.body.map((p) => <p>{p}</p>)}
  </div>
</section>

<section class="solar__section">
  <div class="solar__wrap">
    <h2>{copy.how.title}</h2>
    <div class="solar__steps">
      {copy.how.steps.map((s) => (
        <article class="solar__step">
          <span class="solar__step-n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="solar__section solar__schemes">
  <div class="solar__wrap">
    <h2>{copy.schemes.title}</h2>
    <p class="solar__schemes-lead">{copy.schemes.lead}</p>
    <div class="solar__cards">
      {copy.schemes.items.map((s) => (
        <article class="solar__card">
          <span class="solar__card-n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          <ul class="solar__card-list">
            {s.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <p class="solar__schemes-price">{copy.schemes.price}</p>
  </div>
</section>

<section class="solar__section solar__honest">
  <div class="solar__wrap solar__prose">
    <h2>{copy.honest.title}</h2>
    {copy.honest.body.map((p) => <p>{p}</p>)}
  </div>
</section>

<section class="solar__section">
  <div class="solar__wrap solar__prose">
    <h2>{copy.equipment.title}</h2>
    <p>{copy.equipment.body}</p>
    <div class="solar__gallery">
      {shots.map((src, i) => (
        <div class="solar__shot">
          <figure>
            <img src={src} alt={copy.equipment.captions[i]} loading="lazy" width="800" height="600" />
            <figcaption>{copy.equipment.captions[i]}</figcaption>
          </figure>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="solar__section solar__cases">
  <div class="solar__wrap solar__prose">
    <h2>{copy.cases.title}</h2>
    <p>{copy.cases.body}</p>
    <div class="solar__gallery">
      {clips.map((v, i) => (
        <div class="solar__clip">
          <figure>
            <button class="solar__clip-play" type="button" aria-label={copy.cases.captions[i]}>
              <img src={v.poster} alt={copy.cases.captions[i]} loading="lazy" width="800" height="600" />
              <span class="solar__clip-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </span>
            </button>
            <video class="solar__clip-v" src={v.src} poster={v.poster} preload="none" controls playsinline hidden></video>
            <figcaption>{copy.cases.captions[i]}</figcaption>
          </figure>
        </div>
      ))}
    </div>
  </div>
</section>

<SolarCareForm lang={lang} copy={copy} />

<script is:inline>
  /* Ролик первого экрана: источник выбираем по ширине окна, чтобы на телефоне
     не тянуть полуторамегабайтный файл, и не запускаем вовсе, если в системе
     включено «уменьшить движение». */
  (function () {
    var v = document.querySelector('.solar__hero-video');
    if (!v) return;
    var still = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (still.matches) return;
    var small = window.matchMedia('(max-width: 760px)').matches;
    v.muted = true;
    v.playsInline = true;
    v.src = small ? v.dataset.srcSm : v.dataset.srcLg;
    v.load();
    /* Браузер может отклонить автозапуск, если решает про экономию трафика или
       вкладка ещё не активна. Пробуем ещё раз, когда данных хватает и когда
       вкладку открыли; если так и не пошло — на экране остаётся кадр. */
    function start() {
      var go = v.play();
      if (go && go.catch) go.catch(function () {});
    }
    start();
    v.addEventListener('canplay', start, { once: true });
    v.addEventListener('loadeddata', start, { once: true });
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden && v.paused) start();
    });
  })();

  /* Кейсы: до нажатия на экране только кадр, видео грузится по клику. */
  document.querySelectorAll('.solar__clip').forEach(function (box) {
    var btn = box.querySelector('.solar__clip-play');
    var vid = box.querySelector('.solar__clip-v');
    if (!btn || !vid) return;
    btn.addEventListener('click', function () {
      btn.hidden = true;
      vid.hidden = false;
      vid.play();
    });
  });
</script>
