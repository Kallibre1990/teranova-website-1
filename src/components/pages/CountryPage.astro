---
/* Каталог одной страны производства: какие категории у нас в этой стране
   и какие поставщики уже опубликованы. Страна берётся из профиля поставщика
   (поле country; пусто = Корея, там начиналась платформа). */
import PageHead from './PageHead.astro';
import Atmosphere from '../visual/Atmosphere.astro';
import { localizePath } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';
import { suppliers, supplierContent } from '../../data/suppliers';
import type { CountryKey } from '../../data/site';

interface Props {
  lang: Lang;
  country: CountryKey;
}
const { lang, country } = Astro.props;
const t = ui[lang];
const meta = t.countries.list.find((c) => c.key === country)!;

const mine = suppliers.filter((s) => (s.country ?? 'kr') === country);
/* Категории показываем только те, где у страны есть поставщики — пустых
   разделов на витрине быть не должно. */
const groups = t.categories.groups.filter((g) => mine.some((s) => s.category === g.key));
const arrow =
  '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---

<PageHead sup={t.countries.sup} title={meta.name} sub={meta.blurb} />

<section class="section country">
  <div class="wrap">
    {mine.length === 0 && <p class="country__empty">{t.countries.empty}</p>}

    {
      groups.map((g) => {
        const list = mine.filter((s) => s.category === g.key);
        return (
          <div class="country__group">
            <div class="country__head">
              <h2 class="country__cat">{g.name}</h2>
              <a class="country__all" href={localizePath(`/catalog/${g.key}`, lang)} set:html={t.categories.more + ' ' + arrow} />
            </div>
            <div class="country__grid">
              {list.map((s) => {
                const c = supplierContent(s, lang);
                return (
                  <a class="sup" href={localizePath(`/catalog/${s.slug}`, lang)}>
                    <span class="sup__brand">{s.brand}</span>
                    <h3 class="sup__name">{s.name}</h3>
                    <p class="sup__tag">{c.tagline}</p>
                    <span class="sup__more" set:html={c.ui.more} />
                  </a>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </div>
  <Atmosphere variant="light" />
</section>

<style>
  .country { padding-block: clamp(30px, 5vw, 56px); position: relative; }
  .country__empty { color: var(--muted, #6b7280); max-width: 60ch; }
  .country__group { margin-bottom: clamp(30px, 5vw, 52px); }
  .country__head {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
    gap: 12px; margin-bottom: 16px;
  }
  .country__cat { margin: 0; font-size: clamp(1.25rem, 2.6vw, 1.6rem); }
  .country__all {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: .92rem; font-weight: 600; text-decoration: none; color: inherit; opacity: .75;
  }
  .country__all:hover { opacity: 1; }
  .country__grid {
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .sup {
    display: flex; flex-direction: column; gap: 7px; padding: 20px;
    border: 1px solid rgba(16, 32, 56, .14); border-radius: 14px;
    text-decoration: none; color: inherit; background: rgba(255, 255, 255, .6);
    transition: border-color .2s ease, transform .2s ease;
  }
  .sup:hover { border-color: rgba(16, 32, 56, .32); transform: translateY(-2px); }
  .sup:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
  .sup__brand { font-size: .74rem; letter-spacing: .12em; text-transform: uppercase; opacity: .55; }
  .sup__name { margin: 0; font-size: 1.12rem; letter-spacing: normal; }
  /* карточки на витрине идут капсом; для таглайна это нечитаемо — возвращаем обычный регистр */
  .sup__tag { margin: 0; font-size: .93rem; line-height: 1.5; color: var(--muted, #4b5563); text-transform: none; letter-spacing: normal; }
  .sup__more { margin-top: 4px; font-weight: 600; font-size: .9rem; }
</style>
