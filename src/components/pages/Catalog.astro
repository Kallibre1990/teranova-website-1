---
import PageHead from './PageHead.astro';
import Atmosphere from '../visual/Atmosphere.astro';
import { localizePath } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';
import CategoryArt from '../visual/CategoryArt.astro';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
// Косметика (K-beauty · OEM/ODM) — первой карточкой; «Смежные направления» — последней.
const groups = [
  ...t.categories.groups.filter((g) => g.key === 'cosmetics'),
  ...t.categories.groups.filter((g) => g.key !== 'cosmetics' && g.key !== 'adjacent'),
  ...t.categories.groups.filter((g) => g.key === 'adjacent'),
];

const icons: Record<string, string> = {
  marine: '<circle cx="12" cy="5" r="2.4"/><path d="M12 7.4V21M5 13a7 7 0 0 0 14 0M3.5 13H7M17 13h3.5"/>',
  cosmetics: '<path d="M12 3c3.5 4.2 6 7.2 6 10.5a6 6 0 1 1-12 0C6 10.2 8.5 7.2 12 3Z"/>',
  medical: '<path d="M3 12h4l2 5 4-12 2 7h6"/>',
  industrial: '<circle cx="12" cy="12" r="3.2"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>',
  transport: '<path d="M3 16V6h11v10M14 9h4l3 3v4h-2M3 16h9M7.5 18.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM17.5 18.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/>',
  adjacent: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  chemical: '<path d="M9 3h6M10 3v6l-5 8.5A2 2 0 0 0 7 21h10a2 2 0 0 0 1.7-3.2L14 9V3"/><path d="M7.5 14h9"/>',
};
const arrow = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---

<PageHead sup={t.categories.sup} title={t.pages.catalog.title} sub={t.pages.catalog.sub} />

{/* Страны идут перед категориями: сначала покупатель выбирает, откуда везём. */}
<section class="section origins">
  <div class="wrap">
    <p class="origins__sup">{t.countries.sup}</p>
    <h2 class="origins__h">{t.countries.title}</h2>
    <p class="origins__sub">{t.countries.sub}</p>
    <div class="origins__grid">
      {
        t.countries.list.map((c) => (
          <a class="origin" href={localizePath(`/catalog/country/${c.key}`, lang)}>
            <span class="origin__code">{c.key.toUpperCase()}</span>
            <h3 class="origin__name">{c.name}</h3>
            <p class="origin__blurb">{c.blurb}</p>
            <span class="origin__more" set:html={t.countries.open + ' ' + arrow} />
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="section section--navy catalog">
  <Atmosphere variant="dark" />
  <div class="wrap">
    <div class="cat-carousel" data-carousel>
      <div class="cat-track" data-carousel-track>
        {
          groups.map((g, i) => (
            <a class="cat" href={localizePath(`/catalog/${g.key}`, lang)}>
              <CategoryArt categoryKey={g.key} alt={g.name} />
              <div class="cat__top">
                <span class="cat__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[g.key] ?? icons.adjacent} />
                </span>
                <span class="cat__num">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h2 class="cat__name">{g.name}</h2>
              <p class="cat__blurb">{g.blurb}</p>
              <span class="cat__more" set:html={t.pages.catalog.view + ' ' + arrow} />
            </a>
          ))
        }
      </div>
      <button class="ccar-btn ccar-btn--prev" data-carousel-prev type="button" aria-label={t.common.prev}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      </button>
      <button class="ccar-btn ccar-btn--next" data-carousel-next type="button" aria-label={t.common.next}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
    <p class="cat-demo">{t.categories.demo_note}</p>
  </div>
</section>

<script>
  import '../../scripts/carousel';
</script>

<style>
  /* Страны — вход в каталог до категорий. Спокойный светлый блок,
     чтобы тёмная карусель категорий ниже осталась главным акцентом. */
  .origins { padding-block: clamp(38px, 6vw, 64px); }
  .origins__sup {
    margin: 0 0 6px; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase;
    color: var(--muted, #6b7280);
  }
  .origins__h { margin: 0 0 8px; font-size: clamp(1.5rem, 3.2vw, 2.1rem); text-wrap: balance; }
  .origins__sub { margin: 0 0 22px; max-width: 62ch; color: var(--muted, #6b7280); }
  .origins__grid {
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .origin {
    display: flex; flex-direction: column; gap: 8px; padding: 22px 22px 20px;
    border: 1px solid rgba(16, 32, 56, .14); border-radius: 14px;
    text-decoration: none; color: inherit; background: rgba(255, 255, 255, .55);
    transition: border-color .2s ease, transform .2s ease;
  }
  .origin:hover { border-color: rgba(16, 32, 56, .32); transform: translateY(-2px); }
  .origin:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
  .origin__code {
    font-size: .72rem; letter-spacing: .14em; font-weight: 700; opacity: .5;
  }
  .origin__name { margin: 0; font-size: 1.3rem; }
  .origin__blurb { margin: 0; font-size: .95rem; line-height: 1.55; color: var(--muted, #4b5563); }
  .origin__more { margin-top: 6px; display: inline-flex; align-items: center; gap: 7px; font-weight: 600; font-size: .93rem; }

  .cat-carousel { position: relative; }
  .cat-track {
    display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-behavior: smooth; scrollbar-width: none; -ms-overflow-style: none; padding: 4px 2px 12px;
  }
  .cat-track::-webkit-scrollbar { display: none; }
  .cat-track.is-grabbing { scroll-behavior: auto; cursor: grabbing; }
  .cat {
    flex: 0 0 clamp(252px, 76%, 300px); scroll-snap-align: start;
    position: relative; overflow: hidden;
    display: flex; flex-direction: column;
    background: rgba(255, 255, 255, 0.035); border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--r-lg); padding: 26px 24px;
    transition: transform .25s var(--ease), background .25s, border-color .25s, box-shadow .25s;
  }
  .cat__top, .cat__name, .cat__blurb, .cat__more { position: relative; z-index: 1; }
  .cat:hover { transform: translateY(-6px); background: rgba(37, 99, 212, 0.1); border-color: rgba(63, 122, 224, 0.45); box-shadow: 0 26px 50px -24px rgba(0, 0, 0, 0.7); }
  .cat__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .cat__icon { width: 50px; height: 50px; border-radius: 13px; display: grid; place-items: center; background: rgba(37, 99, 212, 0.16); border: 1px solid rgba(63, 122, 224, 0.3); color: var(--cobalt-light); }
  .cat__icon svg { width: 25px; height: 25px; }
  .cat:hover .cat__icon { background: linear-gradient(140deg, var(--cobalt), var(--cobalt-light)); color: #fff; }
  .cat__num { font-size: 0.9rem; font-weight: 800; color: rgba(255, 255, 255, 0.18); }
  .cat__name { font-size: 1.12rem; font-weight: 800; letter-spacing: -0.01em; color: #fff; margin-bottom: 8px; }
  .cat__blurb { font-size: 0.88rem; color: var(--silver); line-height: 1.55; margin-bottom: 16px; }
  .cat__more { display: inline-flex; align-items: center; gap: 7px; align-self: flex-start; margin-top: auto; padding: 8px 14px; border-radius: 100px; font-size: 0.82rem; font-weight: 700; color: var(--cobalt-light); background: rgba(37, 99, 212, 0.12); border: 1px solid rgba(63, 122, 224, 0.3); transition: background .25s var(--ease), color .25s var(--ease); }
  .cat:hover .cat__more { background: var(--cobalt); color: #fff; }
  .cat-demo { margin-top: 22px; font-size: 0.84rem; color: var(--silver-muted); }

  /* Зона нажатия сужена до 30px, круг 46px рисуется псевдоэлементом и клики не
     перехватывает: по бокам ~34px, вынести кнопку наружу некуда. Вид прежний. */
  .ccar-btn {
    position: absolute; top: 46%; transform: translateY(-50%);
    width: 30px; height: 46px; border-radius: 0; background: transparent; color: #fff;
    border: none; display: grid; place-items: center; box-shadow: none; z-index: 3;
    transition: opacity .2s var(--ease);
  }
  .ccar-btn::before {
    content: ''; position: absolute; top: 50%; left: 50%;
    width: 46px; height: 46px; margin: -23px 0 0 -23px; border-radius: 50%;
    background: var(--cobalt); box-shadow: var(--sh-m); pointer-events: none;
    transition: background .2s var(--ease);
  }
  .ccar-btn svg { position: relative; }
  .ccar-btn:hover::before { background: var(--cobalt-light); }
  .ccar-btn:disabled { opacity: 0; pointer-events: none; }
  .ccar-btn--prev { left: -20px; }
  .ccar-btn--next { right: -20px; }

  @media (hover: none) { .ccar-btn { display: none; } }
  @media (max-width: 560px) { .cat { flex-basis: 84%; } }
  @media (prefers-reduced-motion: reduce) { .cat-track { scroll-behavior: auto; } }
</style>
