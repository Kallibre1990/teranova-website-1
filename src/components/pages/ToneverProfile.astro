---
import SupplierProfile from './SupplierProfile.astro';
import type { SupplierProfile as Profile } from '../../data/suppliers';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang; profile: Profile }
const { lang, profile } = Astro.props;
---
<SupplierProfile lang={lang} profile={profile} />
<style is:global>
  /* SupplierProfile's dynamic card element does not propagate Astro's image
     scope attribute. Constrain the actual supplied cut-outs for this profile. */
  .sp[data-supplier='tonever'] .sp-line__shot img {
    display: block; width: auto; height: auto; max-width: 72px; max-height: 72px;
    object-fit: contain;
  }
  .sp[data-supplier='tonever'] .sp-lvl,
  .sp[data-supplier='tonever'] .sp-tagline,
  .sp[data-supplier='tonever'] .sp-eyebrow,
  .sp[data-supplier='tonever'] .sp-line__more { color: var(--ds-deep); }
  /* No separate format taxonomy was supplied; do not show an empty heading. */
  .sp[data-supplier='tonever'] .sp-cols > div:first-child { display: none; }
  .sp[data-supplier='tonever'] .sp-cols { grid-template-columns: 1fr; max-width: 760px; }
  @media (max-width: 820px) {
    .sp[data-supplier='tonever'] .sp-hero__art { width: min(440px, 100%); }
  }
</style>
