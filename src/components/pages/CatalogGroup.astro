---
import PageHead from './PageHead.astro';
import BeautyHero from './BeautyHero.astro';
import BeautyRoute from './BeautyRoute.astro';
import CosmeticsContent from './CosmeticsContent.astro';
import Atmosphere from '../visual/Atmosphere.astro';
import { localizePath, anchorHref } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';
import type { CategoryKey } from '../../data/site';
import { demoSuppliers } from '../../data/demoSuppliers';
import { suppliers as realSuppliers, beautySuppliers, supplierContent, showcaseImages, showcaseFacts } from '../../data/suppliers';
interface Props {
  lang: Lang;
  groupKey: CategoryKey;
}
const { lang, groupKey } = Astro.props;
const t = ui[lang];
const g = t.pages.group;
const group = t.categories.groups.find((x) => x.key === groupKey)!;
const subs = group.items;

// Cosmetics gets an editorial layer (blocks 1–7) around the demo grids; block 1
// replaces the short head (sup + title + blurb). Other categories keep the plain head.
const isCosmetics = groupKey === 'cosmetics';
const headSup = isCosmetics ? t.pages.cosmetics.intro_sup : t.categories.sup;
const headTitle = isCosmetics ? t.pages.cosmetics.intro_title : group.name;
const headSub = isCosmetics ? t.pages.cosmetics.intro_body : group.blurb;

/* Beauty собирается из рубрики плюс упаковка и сырьё — см. beautySuppliers.
   Остальные группы берут свою рубрику как есть. */
const realForCat =
  groupKey === 'cosmetics' ? beautySuppliers : realSuppliers.filter((s) => s.category === groupKey);
/* Решение Антона 20.08.2026: демонстрационные карточки живут в группе только
   пока она пустая. Как только в направлении набирается три настоящих
   поставщика, выдуманные компании рядом с ними уже не заполняют витрину, а
   подрывают доверие покупателя — и группа переходит на реальные карточки сама,
   без правки кода. */
const DEMO_HIDE_AT = 3;
const showDemo = realForCat.length < DEMO_HIDE_AT;
const suppliers = showDemo ? demoSuppliers[groupKey] ?? [] : [];
/* Страна производства — меткой на карточке. Каталог общий: корейские и
   китайские поставщики лежат в одних категориях, страна их различает. */
/* Ботанические знаки для плашек поставщика без фотографий.
 *
 * Рисуем то, из чего сырьё сделано: корень солодки, корневище куркумы, семя
 * бабчи, кора птерокарпуса, лист центеллы, зерно кофе. Растение — факт
 * природы, его изображение ничего не приписывает конкретной компании.
 * Нарисовать банку с их экстрактом было бы уже утверждением о продукции
 * Sunpure, и это запрещено docs/IMAGERY.md как «доказательство».
 *
 * Линия, а не заливка: рисунок обязан читаться как рисунок, а не как
 * фотография. Двадцать пикселей на телефоне — поэтому силуэты простые.
 */
/* Ботанические кадры Codex: три зоны одного триптиха, разрезанные по видам
 * сырья. Это `generated-editorial`: растение-источник, без тары, этикеток и
 * логотипов. Кадр стоит фоном под настоящей подписью и нигде не выдаётся за
 * снимок продукции Sunpure — происхождение записано в docs/IMAGERY-MANIFEST.md.
 * Для видов сырья без кадра остаётся знак линией. */
const BOTANY_ART_IMG: Partial<Record<string, string>> = {
  root: 'licorice',
  rhizome: 'turmeric',
  seed: 'babchi',
};

const BOTANY_ART: Record<string, string[]> = {
  root: ['M10.4 4.2c0 4-.4 9.2-.9 12.4-.3 2-.7 3.2-1.3 4.2', 'M13.6 4.2c0 4 .4 9.2.9 12.4.3 2 .7 3.2 1.3 4.2', 'M10.2 9.6c-1.8.4-3 1.6-3.6 3.6', 'M13.8 12.4c1.8.4 3 1.6 3.6 3.6', 'M9.4 4.4C10 2.8 12 2.4 12 2.4s2 .4 2.6 2'],
  rhizome: ['M4.6 13.4a2.9 2.9 0 0 1 2.9-2.9c1.7 0 2.3 1.5 4 1.5s2.3-1.5 4-1.5a2.9 2.9 0 0 1 0 5.8c-1.7 0-2.3-1.5-4-1.5s-2.3 1.5-4 1.5a2.9 2.9 0 0 1-2.9-2.9Z', 'M8.2 8.4c.6-1.4 1.8-2.2 3.2-2.4', 'M14.6 7.6c-.4-1.2-1.2-2-2.4-2.4'],
  seed: ['M12 20.5c-3.6-1.8-5.6-4.6-5.6-7.5A5.6 5.6 0 0 1 12 7.4a5.6 5.6 0 0 1 5.6 5.6c0 2.9-2 5.7-5.6 7.5Z', 'M12 20.5V10.4', 'M12 7.4C12 5 13.6 3.5 15.8 3.2'],
  bark: ['M7.6 3.6c-1.6 5.4-1.6 11.4 0 16.8', 'M12 3.2c-1.4 5.6-1.4 11.8 0 17.6', 'M16.4 4c-1.2 4.8-1.2 10.2 0 15.2'],
  leaf: ['M12 20.6a8 8 0 1 1 0-16.2 8 8 0 0 1 0 16.2Z', 'M12 12.5 18 8.6', 'M12 12.5l5.4 4.6', 'M12 12.5 6 8.6', 'M12 12.5l-5.4 4.6', 'M12 12.5v8.1'],
  bean: ['M12 20.8a8.2 8.2 0 1 1 0-16.4 8.2 8.2 0 0 1 0 16.4Z', 'M12 4.6c-2.6 4.4-2.6 10.8 0 16.1'],
  /* Запасной знак: два листа. Используется, когда вид сырья по строке INCI
     определить не удалось. */
  default: ['M12 21c0-6 3-10 8-12-1 7-4 10-8 12Z', 'M12 21C12 15 9 11 4 9c1 7 4 10 8 12Z', 'M12 21v-6'],
};

const countryFlag: Record<string, string> = { kr: '🇰🇷', cn: '🇨🇳', in: '🇮🇳' };
const countryName = (key: string) => t.countries.list.find((c) => c.key === key)?.name ?? '';
const roleLabel = { maker: g.role_maker, oem: g.role_oem, exporter: g.role_exporter } as const;
/* По три собственных снимка на карточку: витрина должна показывать товар,
   а не список юридических лиц. Считаем один раз, до разметки. */
const shots: Record<string, string[]> = Object.fromEntries(
  realForCat.map((s) => [s.slug, showcaseImages(s, 3)]),
);
const statusInfo = {
  visited: { cls: 'badge--visited', label: t.verify.card_visited_t },
  provided: { cls: 'badge--provided', label: t.verify.card_provided_t },
} as const;
---

{/* Новый первый экран пока написан только по-русски: проектируем и принимаем
    по-русски, остальные десять локалей ждут перевода строк. До перевода они
    остаются на прежнем PageHead — иначе английская и корейская страницы
    показали бы русский заголовок. */}
{isCosmetics
  ? <BeautyHero lang={lang} />
  : <PageHead sup={headSup} title={headTitle} sub={headSub} deep={groupKey} />}

{/* Маршрут покупателя идёт сразу за первым экраном: четыре задачи, затем
    отобранные истории, и только потом полный каталог ниже. */}
{isCosmetics && <BeautyRoute lang={lang} part="tasks" />}

{/* Подборка по волосам — перед блоком с примерами карточек.
    Решение Антона от 06.09.2026: покупатель, которому нужны именно волосы,
    должен свернуть в подборку раньше, чем начнёт разбирать примеры. */}
{isCosmetics && (
  <section class="section section--navy bsc bsc--regulatory">
    <span class="bsc-scene" aria-hidden="true"></span>
    <div class="wrap">
      {/* Уход за волосами — ниша внутри косметики, а не восьмая категория.
          Вход стоит перед списком проверенных поставщиков: решение Антона от
          06.09.2026. Так покупатель, которому нужны именно волосы, сворачивает
          в подборку до того, как начнёт разбирать компании по одной. */}
      <a class="sel-plate sel-plate--light hs-link hs-link--solo" href={localizePath('/catalog/hair-scalp', lang)}>
        <span class="sel-plate__txt">
          <span class="sel-plate__sup">{t.pages.hairscalp.sup}</span>
          <span class="sel-plate__t">{t.pages.hairscalp.title}</span>
          <span class="sel-plate__d">{t.pages.hairscalp.sub}</span>
        </span>
        <span class="sel-plate__ar" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>

    </div>
  </section>
)}

{isCosmetics && <BeautyRoute lang={lang} part="stories" />}

{isCosmetics && <CosmeticsContent lang={lang} part="intro" />}

{/* Cosmetics: lift the verified suppliers right after the «why it's hard solo» block so they're seen early. */}
{isCosmetics && <CosmeticsContent lang={lang} part="body" />}

<section class="section section--navy group bsc bsc--packaging">
  <span class="bsc-scene" aria-hidden="true"></span>
  <Atmosphere variant="dark" />
  <div class="wrap">
    <a class="back" href={localizePath('/catalog', lang)}>
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      {g.back}
    </a>

    <div class="group__head">
      <h2 class="lvl" style="margin:0">{g.products_title}</h2>
      {showDemo && <span class="badge badge--provided">{g.demo_badge}</span>}
    </div>
    <div class="prod-grid">
      {
        subs.map((s) => (
          <article class="pcard">
            <span class="pcard__ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8l9 5 9-5ZM3 8v8l9 5 9-5V8M12 13v8"/></svg>
            </span>
            <span class="pcard__nm">{s}</span>
          </article>
        ))
      }
    </div>

    {!isCosmetics && realForCat.length > 0 && (
      <>
        <div class="group__head">
          <h2 class="lvl" style="margin:0">{supplierContent(realForCat[0], lang).ui.verified_suppliers}</h2>
        </div>
        <div class="sup-grid">
          {realForCat.map((s) => {
            const sc = supplierContent(s, lang);
            return (
              <a class="scard scard--real" href={localizePath(`/catalog/${s.slug}`, lang)}>
                <span class={`badge ${statusInfo[s.status].cls}`}><span class="dot" />{statusInfo[s.status].label}</span>
                <h3 class="scard__nm">{s.name}</h3>
                <p class="scard__role">{s.brand} · {sc.descriptor}</p>
                <span class="scard__foot">
                  <span class="scard__more">{sc.ui.more}</span>
                  <span class="scard__origin">{countryFlag[s.country ?? 'kr']} {countryName(s.country ?? 'kr')}</span>
                </span>
              </a>
            );
          })}
        </div>
      </>
    )}

    {suppliers.length > 0 && (
      <>
        <div class="group__head">
          <h2 class="lvl" style="margin:0">{g.suppliers_title}</h2>
          <span class="badge badge--provided">{g.demo_badge}</span>
        </div>
        <div class="sup-grid">
          {
            suppliers.map((s) => (
              <article class="scard">
                <div class="scard__head">
                  <span class="scard__mono" aria-hidden="true">{s.initials}</span>
                  <span class={`badge ${statusInfo[s.status].cls}`}><span class="dot" />{statusInfo[s.status].label}</span>
                </div>
                <h3 class="scard__nm">{s.name}</h3>
                <p class="scard__role">{roleLabel[s.role]} · <span class="scard__demo">{g.demo_badge}</span></p>
                <p class="scard__blurb">{g.blurbs[s.blurb]}</p>
                <div class="scard__tags">{s.tags.map((i) => <span>{subs[i]}</span>)}</div>
                <div class="scard__contacts">
                  <a href={`mailto:${s.email}`}>{s.email}</a>
                  <span>{s.phone}</span>
                </div>
              </article>
            ))
          }
        </div>
      </>
    )}

    <div class="group__foot">
      {suppliers.length > 0 && <span class="note">{g.demo_note}</span>}
      <a class="btn btn--primary" href={anchorHref('ondemand', lang)}>{g.request}</a>
    </div>
  </div>
</section>

{isCosmetics && <CosmeticsContent lang={lang} part="cta" />}

{/* Полный список компаний — в самом низу страницы. Решение Антона от
    06.09.2026. Наверху покупатель выбирает задачу и смотрит примеры; сюда он
    приходит, когда уже готов разбирать компании по одной. */}
{isCosmetics && realForCat.length > 0 && (
  <section class="section section--navy bsc bsc--quality">
    <span class="bsc-scene" aria-hidden="true"></span>
    <div class="wrap">
      <div class="group__head" id="brands">
        <h2 class="lvl" style="margin:0">{supplierContent(realForCat[0], lang).ui.verified_suppliers}</h2>
      </div>
      <div class="sup-grid">
        {realForCat.map((s) => {
          const sc = supplierContent(s, lang);
          return (
            <a class="scard scard--real" href={localizePath(`/catalog/${s.slug}`, lang)}>
              <span class={`badge ${statusInfo[s.status].cls}`}><span class="dot" />{statusInfo[s.status].label}</span>
              <h3 class="scard__nm">{s.name}</h3>
              <p class="scard__role">{s.brand} · {sc.descriptor}</p>
              {shots[s.slug]!.length > 0 ? (
                <span class="scard__shots">
                  {shots[s.slug]!.map((src) => (
                    <span class="scard__pad"><img src={src} alt="" loading="lazy" decoding="async" /></span>
                  ))}
                </span>
              ) : (
                /* Снимков нет — показываем настоящие позиции каталога, а не
                   пустоту и не выдуманную фотографию товара. Гамма плашек —
                   фирменная гамма самой компании. */
                showcaseFacts(s, 3).length > 0 && (
                  <span
                    class="scard__facts"
                    style={s.brandColors
                      ? `--f-deep:${s.brandColors.deep}; --f-mid:${s.brandColors.sky}; --f-accent:${s.brandColors.accent};`
                      : undefined}
                  >
                    {showcaseFacts(s, 3).map((f) => (
                      <span class={`scard__fact${BOTANY_ART_IMG[f.botany ?? ''] ? ' scard__fact--art' : ''}`}>
                        {BOTANY_ART_IMG[f.botany ?? ''] ? (
                          <img
                            class="scard__fact-art"
                            src={`/img/beauty/ingredients/${BOTANY_ART_IMG[f.botany ?? '']}-600.webp`}
                            srcset={`/img/beauty/ingredients/${BOTANY_ART_IMG[f.botany ?? '']}-600.webp 600w, /img/beauty/ingredients/${BOTANY_ART_IMG[f.botany ?? '']}-900.webp 900w`}
                            sizes="(max-width: 620px) 120px, 220px"
                            width="724"
                            height="724"
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <svg class="scard__fact-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            {(BOTANY_ART[f.botany ?? 'default'] ?? BOTANY_ART.default).map((d) => (<path d={d} />))}
                          </svg>
                        )}
                        <span class="scard__fact-nm" lang="en">{f.name}</span>
                        {f.source && <span class="scard__fact-src">{f.source}</span>}
                      </span>
                    ))}
                  </span>
                )
              )}
              <span class="scard__foot">
                <span class="scard__more">{sc.ui.more}</span>
                <span class="scard__origin">{countryFlag[s.country ?? 'kr']} {countryName(s.country ?? 'kr')}</span>
              </span>
            </a>
          );
        })}
      </div>

    </div>
  </section>
)}


<style>
  .back { display: inline-flex; align-items: center; gap: 7px; font-size: 0.86rem; font-weight: 700; color: var(--cobalt-light); margin-bottom: 26px; }
  .lvl { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--silver-muted); margin-bottom: 12px; }
  .prod-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 40px; }
  .pcard { display: flex; align-items: center; gap: 12px; background: rgba(255, 255, 255, 0.035); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--r); padding: 14px 16px; }
  .pcard__ic { width: 34px; height: 34px; flex: none; border-radius: 9px; display: grid; place-items: center; background: rgba(37, 99, 212, 0.16); border: 1px solid rgba(63, 122, 224, 0.3); color: var(--cobalt-light); }
  .pcard__ic svg { width: 18px; height: 18px; }
  .pcard__nm { font-size: 0.9rem; font-weight: 600; color: var(--silver-bright); line-height: 1.3; }
  .group__head { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 16px; }

  .sup-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .scard { display: flex; flex-direction: column; background: rgba(255, 255, 255, 0.035); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--r-lg); padding: 22px; }
  .scard__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .scard__mono { width: 44px; height: 44px; flex: none; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(140deg, var(--cobalt), var(--cobalt-light)); color: #fff; font-weight: 800; font-size: 0.95rem; }
  .scard__nm { font-size: 1.05rem; font-weight: 800; color: #fff; }
  .scard__role { font-size: 0.82rem; color: var(--silver-muted); margin-top: 3px; }
  .scard__demo { color: var(--cobalt-light); font-weight: 700; }
  /* низ карточки: «открыть профиль» слева, страна производства справа */
  .scard__foot { margin-top: auto; padding-top: 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .scard__origin { font-size: .78rem; color: var(--silver-muted); white-space: nowrap; letter-spacing: .02em; }
  .scard__blurb { font-size: 0.9rem; color: var(--silver); line-height: 1.6; margin-top: 12px; }
  .scard__tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 14px; }
  .scard__tags span { font-size: 0.74rem; font-weight: 600; color: var(--silver-muted); background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 100px; padding: 4px 10px; }
  .scard__contacts { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 16px; padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.82rem; }
  .scard__contacts a { color: var(--cobalt-light); word-break: break-all; }
  .scard__contacts a:hover { color: #fff; }
  .scard__contacts span { color: var(--silver-muted); }
  .scard--real { cursor: pointer; text-decoration: none; transition: transform .2s var(--ease), box-shadow .2s, border-color .2s; }
  .scard--real:hover { transform: translateY(-3px); border-color: rgba(63, 122, 224, 0.5); box-shadow: 0 14px 34px rgba(3, 10, 24, 0.4); }
  .scard__more { margin-top: auto; padding-top: 14px; font-size: 0.86rem; font-weight: 700; color: var(--cobalt-light); }

  /* ---- витрина Beauty: карточка компании с её собственными снимками ---- */
  .section--beauty .scard { background: var(--beauty-surface); border-color: var(--beauty-line); }
  .section--beauty .scard__nm { color: var(--ink); }
  .section--beauty .scard__role { color: var(--beauty-sub); }
  .section--beauty .scard__more { color: var(--cobalt); }
  .section--beauty .scard__origin { color: var(--beauty-sub); }
  .section--beauty .scard--real:hover { border-color: color-mix(in srgb, var(--beauty-accent) 40%, var(--beauty-line)); box-shadow: 0 14px 34px rgba(11, 27, 53, 0.08); }
  .scard__shots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 14px; }
  /* Подложка одного тона под каждым снимком. Фотографии поставщиков сняты на
     разных фонах — на светлой витрине без общей подложки ряд читается как
     лоскутное одеяло. */
  .scard__pad { background: var(--beauty-pad); border-radius: 12px; aspect-ratio: 1 / 1; display: grid; place-items: center; overflow: hidden; }
  .scard__pad img { width: 84%; height: 84%; object-fit: contain; display: block; }

  .group__foot { margin-top: 28px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .group__foot .note { font-size: 0.84rem; color: var(--silver-muted); max-width: 48ch; }
  @media (max-width: 820px) { .sup-grid { grid-template-columns: 1fr; } .prod-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .prod-grid { grid-template-columns: 1fr; } }

  /* Ссылка на подборку «Волосы и кожа головы» на странице косметики.
     Вид — общая серебряная плита .sel-plate из global.css; здесь только отступ. */
  .hs-link { margin-top: 18px; }
  /* Вход в подборку поднят над списком поставщиков — сверху отступа не нужно,
     нужен снизу, до заголовка «Проверенные поставщики». */
  .hs-link--top { margin-top: 0; margin-bottom: clamp(28px, 3.4vw, 44px); }
  /* Плита стоит отдельной секцией, соседей сверху и снизу у неё нет. */
  .hs-link--solo { margin: 0; }

  /* ---- карточка поставщика без фотографий ----
       ВНИМАНИЕ: эти правила НЕ должны уезжать в beauty.css. Разметка плашек
       отдаётся на всех одиннадцати языках, а бархатная тема стоит пока только
       на русской странице. Когда стили лежали в теме, на остальных десяти
       языках три картинки 724 px разворачивались во всю величину и карточка
       вырастала с 400 до 2465 px.
     Sunpure прислал брошюру, но не снимки сырья. Рисовать за компанию её товар
     нельзя — это подделка, а не иллюстрация. Пустая карточка при этом выглядела
     как ошибка вёрстки: половина плитки просто пустовала.

     Показываем настоящие позиции каталога: название актива и растение-источник.
     Плашки красим фирменной гаммой самой компании (`--f-*` приходят из её
     brandColors), лист нарисован кодом. Когда компания пришлёт фотографии,
     этот блок исчезнет сам — он показывается только при пустом showcaseImages. */
  .scard__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 4px;
  }
  .scard__fact {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    min-height: 122px;
    /* height: auto по умолчанию — плашка обязана расти под перенос, поэтому
       min-height, а не height. */
    padding: 12px 11px 13px;
    border-radius: 5px;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 22% 8%, color-mix(in srgb, var(--f-mid, #4e9a5f) 46%, transparent), transparent 62%),
      linear-gradient(158deg, color-mix(in srgb, var(--f-deep, #1d4a2b) 92%, #000) 0%, color-mix(in srgb, var(--f-deep, #1d4a2b) 62%, var(--b-velvet)) 100%);
    border: 1px solid color-mix(in srgb, var(--f-accent, #d9a441) 34%, transparent);
  }
  .scard__fact-mark {
    position: absolute;
    top: 10px; right: 10px;
    width: 30px; height: 30px;
    fill: none;
    stroke: var(--f-accent, #d9a441);
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.78;
  }
  .scard__fact-nm {
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: #f4f7f4;
    text-wrap: balance;
    /* «Tetrahydrocurcumin» — 18 символов без единого пробела. В колонке шириной
       около 100 px на 390 px такое слово не переносится и обрезается
       `overflow: hidden` плашки. Сокращать название нельзя: покупатель ищет
       сырьё именно по нему. Разрешаем перенос внутри слова и просим браузер
       ставить дефис там, где это уместно по правилам языка.
       `hyphenate-limit-chars` не даёт отрывать одну-две буквы. */
    /* break-word, а не anywhere: `anywhere` обнуляет минимальную ширину слова,
       колонки сетки схлопываются, и рвётся даже короткое «Glabridin» — вышло
       «Glabri / din». `break-word` разрывает слово только тогда, когда оно
       действительно не помещается, а ширину колонок не трогает.
       Переносы по-английски: имена активов латинские, и словарь переносов
       выбирается по языку элемента — отсюда lang="en" в разметке. */
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  .scard__fact-src {
    overflow-wrap: break-word;
    font-size: 0.68rem;
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--f-accent, #d9a441) 76%, #ffffff);
  }
  /* На телефоне карточка поставщика сужается до 342 px (390 px экрана) и до
     272 px (320 px экрана). Делить такую ширину на три колонки нельзя:
     «Tetrahydrocurcumin» — 18 символов без пробела, в колонку около 80 px оно
     не влезает ни при каком переносе, а сокращать химическое название нельзя —
     покупатель ищет сырьё именно по нему.
     Поэтому на узком экране плашки идут в столбик: имя получает всю ширину
     карточки и умещается в одну строку. */
  @media (max-width: 620px) {
    .scard__facts { grid-template-columns: 1fr; gap: 6px; }
    /* Лист слева, название и источник — в столбик справа от него.
       В одну строку они не влезают: на карточке 272 px под текст остаётся
       около 180 px, а «Tetrahydrocurcumin» плюс «Turmeric» просят почти 200 —
       источник уезжал за край и срезался. Сетка два на два решает это без
       сокращений и без переносов внутри слова. */
    .scard__fact {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: 10px;
      row-gap: 1px;
      min-height: 0;
      padding: 9px 12px 10px;
    }
    .scard__fact-mark {
      position: static;
      grid-row: 1 / -1;
      grid-column: 1;
      width: 22px; height: 22px;
      opacity: 0.88;
    }
    .scard__fact-nm { grid-column: 2; font-size: 0.86rem; }
    .scard__fact-src { grid-column: 2; }
  }

  /* ---- ботанический кадр на плашке ----
     Кадр — редакционная иллюстрация сырья (триптих Codex, класс
     `generated-editorial`): корень солодки, корневище куркумы, семена бабчи.
     Ни тары, ни этикеток, ни логотипов — растение и только оно. Кадр лежит
     фоном под настоящей подписью и продукцией Sunpure не является.

     Подпись обязана читаться на самом светлом месте кадра — срез куркумы
     почти оранжевый. Поэтому шторка снизу плотная, а не декоративная. */
  .scard__fact--art { padding: 0; }
  .scard__fact-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    z-index: 0;
  }
  .scard__fact--art::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(6, 20, 12, 0.12) 0%, rgba(6, 20, 12, 0.5) 44%, rgba(5, 16, 10, 0.9) 100%);
  }
  .scard__fact--art .scard__fact-nm,
  .scard__fact--art .scard__fact-src {
    position: relative;
    z-index: 2;
    padding-left: 12px;
    padding-right: 12px;
  }
  .scard__fact--art .scard__fact-nm { margin-top: auto; }
  .scard__fact--art .scard__fact-src { padding-bottom: 12px; }

  @media (max-width: 620px) {
    /* Строкой: растение занимает левую треть, подпись стоит справа на
       затемнении. Высота поднята — иначе от кадра осталась бы полоска. */
    /* Плашка с кадром на телефоне НЕ переходит в строку. В строке текст
       остаётся 130 px шириной, и «Tetrahydrocurcumin» ломается на три части.
       Оставляем ту же раскладку, что на десктопе, только ниже: кадр во всю
       плашку, подпись снизу во всю ширину — там ей 212 px, и слово помещается
       в строку. В строку переходят только плашки без кадра. */
    .scard__fact--art {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      /* align-items: center достаётся от правила для плашек без кадра —
         в колоночном flex оно центрует подпись. Здесь она прижата влево. */
      align-items: stretch;
      text-align: left;
      min-height: 96px;
      padding: 0;
    }
    .scard__fact--art .scard__fact-art {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 44%;
    }
    .scard__fact--art::after {
      background: linear-gradient(180deg, rgba(6, 20, 12, 0.08) 0%, rgba(6, 20, 12, 0.44) 40%, rgba(5, 16, 10, 0.92) 100%);
    }
    .scard__fact--art .scard__fact-nm {
      margin-top: auto;
      padding: 0 12px;
      font-size: 0.86rem;
    }
    .scard__fact--art .scard__fact-src { padding: 0 12px 11px; }
  }
