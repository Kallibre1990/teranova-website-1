---
import PageHead from './PageHead.astro';
import CosmeticsContent from './CosmeticsContent.astro';
import Atmosphere from '../visual/Atmosphere.astro';
import { localizePath, anchorHref } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';
import type { CategoryKey } from '../../data/site';
import { demoSuppliers } from '../../data/demoSuppliers';
import { suppliers as realSuppliers, supplierContent } from '../../data/suppliers';
interface Props {
  lang: Lang;
  groupKey: CategoryKey;
}
const { lang, groupKey } = Astro.props;
const t = ui[lang];
const g = t.pages.group;
const group = t.categories.groups.find((x) => x.key === groupKey)!;
const subs = group.items;

// Cosmetics gets an editorial layer (blocks 1–7) around the demo grids; block 1
// replaces the short head (sup + title + blurb). Other categories keep the plain head.
const isCosmetics = groupKey === 'cosmetics';
const headSup = isCosmetics ? t.pages.cosmetics.intro_sup : t.categories.sup;
const headTitle = isCosmetics ? t.pages.cosmetics.intro_title : group.name;
const headSub = isCosmetics ? t.pages.cosmetics.intro_body : group.blurb;

const realForCat = realSuppliers.filter((s) => s.category === groupKey);
/* Решение Антона 20.08.2026: демонстрационные карточки живут в группе только
   пока она пустая. Как только в направлении набирается три настоящих
   поставщика, выдуманные компании рядом с ними уже не заполняют витрину, а
   подрывают доверие покупателя — и группа переходит на реальные карточки сама,
   без правки кода. */
const DEMO_HIDE_AT = 3;
const showDemo = realForCat.length < DEMO_HIDE_AT;
const suppliers = showDemo ? demoSuppliers[groupKey] ?? [] : [];
/* Страна производства — меткой на карточке. Каталог общий: корейские и
   китайские поставщики лежат в одних категориях, страна их различает. */
const countryFlag: Record<string, string> = { kr: '🇰🇷', cn: '🇨🇳', in: '🇮🇳' };
const countryName = (key: string) => t.countries.list.find((c) => c.key === key)?.name ?? '';
const roleLabel = { maker: g.role_maker, oem: g.role_oem, exporter: g.role_exporter } as const;
const statusInfo = {
  visited: { cls: 'badge--visited', label: t.verify.card_visited_t },
  provided: { cls: 'badge--provided', label: t.verify.card_provided_t },
} as const;
---

<PageHead sup={headSup} title={headTitle} sub={headSub} deep={groupKey} />

{isCosmetics && <CosmeticsContent lang={lang} part="intro" />}

{/* Cosmetics: lift the verified suppliers right after the «why it's hard solo» block so they're seen early. */}
{isCosmetics && realForCat.length > 0 && (
  <section class="section section--navy">
    <Atmosphere variant="dark" />
    <div class="wrap">
      <div class="group__head">
        <h2 class="lvl" style="margin:0">{supplierContent(realForCat[0], lang).ui.verified_suppliers}</h2>
      </div>
      <div class="sup-grid">
        {realForCat.map((s) => {
          const sc = supplierContent(s, lang);
          return (
            <a class="scard scard--real" href={localizePath(`/catalog/${s.slug}`, lang)}>
              <span class={`badge ${statusInfo[s.status].cls}`}><span class="dot" />{statusInfo[s.status].label}</span>
              <h3 class="scard__nm">{s.name}</h3>
              <p class="scard__role">{s.brand} · {sc.descriptor}</p>
              <span class="scard__foot">
                <span class="scard__more">{sc.ui.more}</span>
                <span class="scard__origin">{countryFlag[s.country ?? 'kr']} {countryName(s.country ?? 'kr')}</span>
              </span>
            </a>
          );
        })}
      </div>

      {/* Уход за волосами — ниша внутри косметики, а не восьмая категория.
          Ссылка стоит сразу под проверенными поставщиками: покупатель, который
          дошёл до этого места, уже смотрит компании, а не разделы. */}
      <a class="hs-link" href={localizePath('/catalog/hair-scalp', lang)}>
        <span class="hs-link__txt">
          <span class="hs-link__sup">{t.pages.hairscalp.sup}</span>
          <span class="hs-link__t">{t.pages.hairscalp.title}</span>
          <span class="hs-link__s">{t.pages.hairscalp.sub}</span>
        </span>
        <svg class="hs-link__ar" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </section>
)}

{isCosmetics && <CosmeticsContent lang={lang} part="body" />}

<section class="section section--navy group">
  <Atmosphere variant="dark" />
  <div class="wrap">
    <a class="back" href={localizePath('/catalog', lang)}>
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      {g.back}
    </a>

    <div class="group__head">
      <h2 class="lvl" style="margin:0">{g.products_title}</h2>
      {showDemo && <span class="badge badge--provided">{g.demo_badge}</span>}
    </div>
    <div class="prod-grid">
      {
        subs.map((s) => (
          <article class="pcard">
            <span class="pcard__ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8l9 5 9-5ZM3 8v8l9 5 9-5V8M12 13v8"/></svg>
            </span>
            <span class="pcard__nm">{s}</span>
          </article>
        ))
      }
    </div>

    {!isCosmetics && realForCat.length > 0 && (
      <>
        <div class="group__head">
          <h2 class="lvl" style="margin:0">{supplierContent(realForCat[0], lang).ui.verified_suppliers}</h2>
        </div>
        <div class="sup-grid">
          {realForCat.map((s) => {
            const sc = supplierContent(s, lang);
            return (
              <a class="scard scard--real" href={localizePath(`/catalog/${s.slug}`, lang)}>
                <span class={`badge ${statusInfo[s.status].cls}`}><span class="dot" />{statusInfo[s.status].label}</span>
                <h3 class="scard__nm">{s.name}</h3>
                <p class="scard__role">{s.brand} · {sc.descriptor}</p>
                <span class="scard__foot">
                  <span class="scard__more">{sc.ui.more}</span>
                  <span class="scard__origin">{countryFlag[s.country ?? 'kr']} {countryName(s.country ?? 'kr')}</span>
                </span>
              </a>
            );
          })}
        </div>
      </>
    )}

    {suppliers.length > 0 && (
      <>
        <div class="group__head">
          <h2 class="lvl" style="margin:0">{g.suppliers_title}</h2>
          <span class="badge badge--provided">{g.demo_badge}</span>
        </div>
        <div class="sup-grid">
          {
            suppliers.map((s) => (
              <article class="scard">
                <div class="scard__head">
                  <span class="scard__mono" aria-hidden="true">{s.initials}</span>
                  <span class={`badge ${statusInfo[s.status].cls}`}><span class="dot" />{statusInfo[s.status].label}</span>
                </div>
                <h3 class="scard__nm">{s.name}</h3>
                <p class="scard__role">{roleLabel[s.role]} · <span class="scard__demo">{g.demo_badge}</span></p>
                <p class="scard__blurb">{g.blurbs[s.blurb]}</p>
                <div class="scard__tags">{s.tags.map((i) => <span>{subs[i]}</span>)}</div>
                <div class="scard__contacts">
                  <a href={`mailto:${s.email}`}>{s.email}</a>
                  <span>{s.phone}</span>
                </div>
              </article>
            ))
          }
        </div>
      </>
    )}

    <div class="group__foot">
      {suppliers.length > 0 && <span class="note">{g.demo_note}</span>}
      <a class="btn btn--primary" href={anchorHref('ondemand', lang)}>{g.request}</a>
    </div>
  </div>
</section>

{isCosmetics && <CosmeticsContent lang={lang} part="cta" />}

<style>
  .back { display: inline-flex; align-items: center; gap: 7px; font-size: 0.86rem; font-weight: 700; color: var(--cobalt-light); margin-bottom: 26px; }
  .lvl { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--silver-muted); margin-bottom: 12px; }
  .prod-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 40px; }
  .pcard { display: flex; align-items: center; gap: 12px; background: rgba(255, 255, 255, 0.035); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--r); padding: 14px 16px; }
  .pcard__ic { width: 34px; height: 34px; flex: none; border-radius: 9px; display: grid; place-items: center; background: rgba(37, 99, 212, 0.16); border: 1px solid rgba(63, 122, 224, 0.3); color: var(--cobalt-light); }
  .pcard__ic svg { width: 18px; height: 18px; }
  .pcard__nm { font-size: 0.9rem; font-weight: 600; color: var(--silver-bright); line-height: 1.3; }
  .group__head { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 16px; }

  .sup-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .scard { display: flex; flex-direction: column; background: rgba(255, 255, 255, 0.035); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--r-lg); padding: 22px; }
  .scard__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .scard__mono { width: 44px; height: 44px; flex: none; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(140deg, var(--cobalt), var(--cobalt-light)); color: #fff; font-weight: 800; font-size: 0.95rem; }
  .scard__nm { font-size: 1.05rem; font-weight: 800; color: #fff; }
  .scard__role { font-size: 0.82rem; color: var(--silver-muted); margin-top: 3px; }
  .scard__demo { color: var(--cobalt-light); font-weight: 700; }
  /* низ карточки: «открыть профиль» слева, страна производства справа */
  .scard__foot { margin-top: auto; padding-top: 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .scard__origin { font-size: .78rem; color: var(--silver-muted); white-space: nowrap; letter-spacing: .02em; }
  .scard__blurb { font-size: 0.9rem; color: var(--silver); line-height: 1.6; margin-top: 12px; }
  .scard__tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 14px; }
  .scard__tags span { font-size: 0.74rem; font-weight: 600; color: var(--silver-muted); background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 100px; padding: 4px 10px; }
  .scard__contacts { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 16px; padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.82rem; }
  .scard__contacts a { color: var(--cobalt-light); word-break: break-all; }
  .scard__contacts a:hover { color: #fff; }
  .scard__contacts span { color: var(--silver-muted); }
  .scard--real { cursor: pointer; text-decoration: none; transition: transform .2s var(--ease), box-shadow .2s, border-color .2s; }
  .scard--real:hover { transform: translateY(-3px); border-color: rgba(63, 122, 224, 0.5); box-shadow: 0 14px 34px rgba(3, 10, 24, 0.4); }
  .scard__more { margin-top: auto; padding-top: 14px; font-size: 0.86rem; font-weight: 700; color: var(--cobalt-light); }

  .group__foot { margin-top: 28px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .group__foot .note { font-size: 0.84rem; color: var(--silver-muted); max-width: 48ch; }
  @media (max-width: 820px) { .sup-grid { grid-template-columns: 1fr; } .prod-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .prod-grid { grid-template-columns: 1fr; } }

  /* Ссылка на подборку «Волосы и кожа головы» на странице косметики */
  .hs-link { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 18px; padding: 20px 22px; border: 1px solid rgba(63, 122, 224, 0.32); border-radius: var(--r-lg); background: rgba(37, 99, 212, 0.09); text-decoration: none; transition: border-color .2s, background .2s, transform .2s var(--ease); }
  .hs-link:hover { border-color: rgba(63, 122, 224, 0.62); background: rgba(37, 99, 212, 0.15); transform: translateY(-2px); }
  .hs-link__txt { display: block; }
  .hs-link__sup { display: block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cobalt-light); }
  .hs-link__t { display: block; font-size: 1.05rem; font-weight: 800; color: #fff; margin-top: 5px; }
  .hs-link__s { display: block; font-size: 0.88rem; color: var(--silver); line-height: 1.6; margin-top: 6px; max-width: 62ch; }
  .hs-link__ar { flex: none; color: var(--cobalt-light); }
  @media (max-width: 620px) { .hs-link__ar { display: none; } }
</style>
