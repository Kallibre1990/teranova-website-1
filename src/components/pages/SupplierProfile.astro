---
/* Supplier profile page — themed in the supplier's own brand colors on top of the
   Teranova chrome. First use: SANTE COSMETICS / Dr.SANTE. Light, clinical
   dermatology aesthetic (the supplier's identity), distinct from the site's navy.
   Images/logo used under the supplier's written consent (docs/CONTENT-RULES §7).
   Copy is localized per language via supplierContent(profile, lang). */
import { Image } from 'astro:assets';
import { localizePath, anchorHref } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';
import { supplierContent, linePages, type SupplierProfile } from '../../data/suppliers';
import { postsBySupplier, postContent } from '../../data/blog';
import BrandField from '../visual/BrandField.astro';
import { coverProductsForShelf, coverPlan } from '../../data/cutouts';
import BrandCover from '../visual/BrandCover.astro';
import santeLogo from '../../assets/suppliers/dr-sante-logo.png';
import dreamcosLogo from '../../assets/suppliers/dreamcos-logo.png';
import santeHero from '../../assets/suppliers/sante/hero-serum.png';
import santeProducts from '../../assets/suppliers/sante/products.jpg';
import santeDrops from '../../assets/suppliers/sante/drops.jpg';
import ddgHero from '../../assets/suppliers/dongdonggurimoo/hero.jpg';
import ddgProducts from '../../assets/suppliers/dongdonggurimoo/products.jpg';
import ddgDrops from '../../assets/suppliers/dongdonggurimoo/drops.jpg';
import ckrHero from '../../assets/suppliers/ck-regeon/hero.jpg';
import ckrProducts from '../../assets/suppliers/ck-regeon/products.jpg';
import ckrDrops from '../../assets/suppliers/ck-regeon/drops.jpg';
import dcHero from '../../assets/suppliers/dreamcos/hero.jpg';
import dcProducts from '../../assets/suppliers/dreamcos/products.jpg';
import dcDrops from '../../assets/suppliers/dreamcos/drops.jpg';
import jetsHero from '../../assets/suppliers/jetsglobal/hero.jpg';
import jetsProducts from '../../assets/suppliers/jetsglobal/products.jpg';
import jetsDrops from '../../assets/suppliers/jetsglobal/drops.jpg';
import pineHero from '../../assets/suppliers/pineworld/hero.jpg';
import pineProducts from '../../assets/suppliers/pineworld/products.jpg';
import pineDrops from '../../assets/suppliers/pineworld/drops.jpg';
import kiftHero from '../../assets/suppliers/kift/hero.jpg';
import kiftProducts from '../../assets/suppliers/kift/products.jpg';
import kiftDrops from '../../assets/suppliers/kift/drops.jpg';
import icelmediHero from '../../assets/suppliers/icelmedi/hero.jpg';
import icelmediProducts from '../../assets/suppliers/icelmedi/products.jpg';
import icelmediDrops from '../../assets/suppliers/icelmedi/drops.jpg';
import tdlHero from '../../assets/suppliers/three-days-love/hero.jpg';
import tdlProducts from '../../assets/suppliers/three-days-love/products.jpg';
import tdlDrops from '../../assets/suppliers/three-days-love/drops.jpg';
import licorneHero from '../../assets/suppliers/licorne/hero.jpg';
import licorneProducts from '../../assets/suppliers/licorne/products.jpg';
import licorneDrops from '../../assets/suppliers/licorne/drops.jpg';

interface Props {
  lang: Lang;
  profile: SupplierProfile;
}
const { lang, profile } = Astro.props;
const t = ui[lang];
const c = supplierContent(profile, lang);
const logos: Record<string, ImageMetadata> = { sante: santeLogo, dreamcos: dreamcosLogo };
const logo = logos[profile.slug];
const media: Record<string, { hero: ImageMetadata; products: ImageMetadata; drops: ImageMetadata }> = {
  sante: { hero: santeHero, products: santeProducts, drops: santeDrops },
  dongdonggurimoo: { hero: ddgHero, products: ddgProducts, drops: ddgDrops },
  'ck-regeon': { hero: ckrHero, products: ckrProducts, drops: ckrDrops },
  dreamcos: { hero: dcHero, products: dcProducts, drops: dcDrops },
  jetsglobal: { hero: jetsHero, products: jetsProducts, drops: jetsDrops },
  pineworld: { hero: pineHero, products: pineProducts, drops: pineDrops },
  kift: { hero: kiftHero, products: kiftProducts, drops: kiftDrops },
  icelmedi: { hero: icelmediHero, products: icelmediProducts, drops: icelmediDrops },
  'three-days-love': { hero: tdlHero, products: tdlProducts, drops: tdlDrops },
  licorne: { hero: licorneHero, products: licorneProducts, drops: licorneDrops },
};
const m = media[profile.slug];
const termsHref = profile.termsFile?.[lang] ?? profile.termsFile?.ru;
const priceHref = profile.priceFile?.[lang] ?? profile.priceFile?.ru;
const presHref = profile.presFile?.[lang] ?? profile.presFile?.ru;
/* A line gets its own indexable page when we have content for it; matched by the
   display name so both the "product lines" block and the catalog groups link to it.
   The lines block often uses a short brand name ("Acerola") where the catalog group
   spells it out ("Acerola Dark Spot & Blemish Care"), so fall back to a prefix match
   — but only when it resolves to exactly one page, to avoid linking the wrong line. */
const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
const lineHref = (nm: string): string | null => {
  const own = linePages.filter((p) => p.supplierSlug === profile.slug);
  const key = norm(nm);
  let page = own.find((p) => norm(p.lineName ?? '') === key || p.slug === nm);
  if (!page && key) {
    const near = own.filter((p) => norm(p.lineName ?? '').startsWith(key));
    if (near.length === 1) page = near[0];
  }
  return page ? localizePath(`/catalog/${profile.slug}/${page.slug}`, lang) : null;
};
const cat = t.categories.groups.find((g) => g.key === profile.category);
const articles = [...postsBySupplier(profile.slug)].sort((a, b) => (a.hero ? 0 : 1) - (b.hero ? 0 : 1));
/* Same covers as the blog listing, so an article looks identical wherever it is
   shown. Product choice is driven by the Russian text in every language. */
const articleCovers = new Map(
  articles.map((post) => {
    const r = postContent(post, 'ru');
    const text = [r.title, r.excerpt, ...r.sections.flatMap((x) => [x.h ?? '', ...x.p])].join(' ');
    return [post.slug, coverPlan(profile.slug, post.slug, post.hero, text)];
  }),
);
const brandStyle = `--ds-deep:${profile.brandColors.deep};--ds-sky:${profile.brandColors.sky};--ds-accent:${profile.brandColors.accent};--ds-bg:${profile.brandColors.bg};`;
/* The brand's own manner on top of our layout — motif, shapes, serif headings. */
const voice = profile.voice ?? 'clinical';
/* Up to four of the brand's own products for the hero shelf — cut-outs when we
   have clean ones, otherwise nothing (a ragged edge would cheapen the header). */
const shelf = coverProductsForShelf(profile.slug);

/* One product photo per product line. The lines block and the catalog groups
   name the same line differently often enough that an exact match leaves cards
   empty ("Multi-Solution" vs "Multi-Solution Line", "Acerola" vs "Acerola Dark
   Spot & Blemish Care"), so widen the search step by step and stop at the first
   hit: the group, then any product whose own name carries the line. */
function lineShot(name: string): string | undefined {
  const groups = profile.catalog ?? [];
  const key = norm(name);
  if (!key) return undefined;

  const byGroup =
    groups.find((x) => norm(x.line) === key) ??
    groups.find((x) => norm(x.line).includes(key) || key.includes(norm(x.line)));
  const own = byGroup?.items.find((i) => i.img)?.img;
  if (own) return own;

  /* No group by that name — the line may still be present as products. */
  for (const g of groups) {
    const hit = g.items.find((i) => i.img && norm(i.name).includes(key));
    if (hit) return hit.img;
  }

  /* Last resort: match on the words that carry meaning. KIFT lists its lines as
     "All-in-One Serum / Cream / Mask / Soap" while the catalog spells the same
     products out as "Multi-Solution Face & Eye Serum" — one shared word is
     enough to show the right kind of product. A line named after a brand
     (LEBELAGE, HEEYUL) matches nothing here on purpose: we do not know which
     bottle belongs to which brand, and guessing would put a wrong product under
     a brand name. */
  const GENERIC = new Set(['all', 'one', 'line', 'care', 'the', 'and', 'for', 'skin', 'premium', 'daily']);
  const words = key.split(' ').filter((w) => w.length > 2 && !GENERIC.has(w));
  if (!words.length) return undefined;
  let best: { img: string; score: number } | undefined;
  for (const g of groups) {
    for (const i of g.items) {
      if (!i.img) continue;
      const hay = `${norm(g.line)} ${norm(i.name)}`;
      const score = words.filter((w) => hay.includes(w)).length;
      if (score && (!best || score > best.score)) best = { img: i.img, score };
    }
  }
  return best?.img;
}
---

<article class={`sp sp--${voice}`} style={brandStyle}>
  <!-- HERO -->
  <section class="sp-hero">
    <BrandField voice={voice} seed={profile.slug} />
    <div class="wrap">
      <nav class="sp-crumbs" aria-label="breadcrumb">
        <a href={localizePath('/catalog', lang)}>{t.nav.catalog}</a>
        <span aria-hidden="true">/</span>
        <a href={localizePath(`/catalog/${profile.category}`, lang)}>{cat?.name}</a>
      </nav>

      <div class="sp-hero__grid">
        <div class="sp-hero__main">
          <span class="sp-eyebrow">{c.ui.profile_sup}</span>
          <figure class="sp-logo">
            {logo && <Image src={logo} alt={`${profile.brand}`} widths={[220, 440]} sizes="220px" format="webp" loading="eager" decoding="async" />}
          </figure>
          <h1 class="sp-name">{profile.name}</h1>
          <p class="sp-tagline">«{c.tagline}»</p>
          <p class="sp-descriptor">{c.descriptor}</p>
          <div class="sp-meta">
            <span class={`sp-status${profile.status === 'visited' ? ' sp-status--visited' : ''}`}><span class="dot" aria-hidden="true"></span>{profile.status === 'visited' ? t.verify.card_visited_t : t.verify.card_provided_t}{profile.status === 'visited' && profile.visitDate ? ` · ${profile.visitDate}` : ''}</span>
            <span class="sp-origin">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.5-7-11a7 7 0 0 1 14 0c0 4.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
              {c.origin}
            </span>
          </div>
        </div>
        {m && (
          <aside class="sp-hero__art">
            <figure class="sp-hero__photo">
              <Image src={m.hero} alt={`${profile.brand} — ${c.descriptor}`} widths={[440, 720]} sizes="(max-width: 820px) 92vw, 440px" format="webp" loading="eager" decoding="async" />
            </figure>
            {shelf.length > 0 && (
              /* A short shelf of the brand's own products under the photo: the
                 page says "supplier profile" in words and shows it at a glance. */
              <div class="sp-hero__shelf" aria-hidden="true">
                {shelf.map((src) => (
                  /* sized inline: the tag comes from an expression, so neither the
                     scoped rule nor the global img rule reaches it reliably */
                  <span class="sp-hero__item">
                    <img src={src} alt="" loading="eager" decoding="async" />
                  </span>
                ))}
              </div>
            )}
          </aside>
        )}
      </div>
    </div>
  </section>

  {profile.status === 'visited' && profile.visitGallery && profile.visitGallery.length > 0 && (
    <section class="sp-sec sp-sec--tint">
      <div class="wrap">
        <span class="sp-lvl sp-lvl--visited">{t.verify.card_visited_t}{profile.visitDate ? ` · ${profile.visitDate}` : ''}</span>
        <p class="sp-visit__note">{t.verify.card_visited_d}</p>
        <div class="sp-visit">
          {profile.visitGallery.map((src, i) => (
            <button class="sp-visit__i" type="button" data-full={src} data-name={`${profile.brand} — ${t.verify.card_visited_t}`}>
              <img src={src} alt={`${profile.name} — ${t.verify.card_visited_t} ${i + 1}`} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ABOUT -->
  <section class="sp-sec">
    <div class="wrap sp-narrow">
      <span class="sp-lvl">{c.ui.about_h}</span>
      {c.about.map((p) => <p class="sp-body">{p}</p>)}
      <ul class="sp-facts">{c.facts.map((f) => <li>{f}</li>)}</ul>
      {c.channels?.length > 0 && (
        <div class="sp-channels">
          <span class="sp-channels__lbl">{c.ui.for_whom}</span>
          <ul class="sp-chips-inline">{c.channels.map((ch) => <li>{ch}</li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <!-- LINES -->
  <section class="sp-sec sp-sec--tint">
    <div class="wrap">
      <span class="sp-lvl">{c.ui.lines_h}</span>
      <div class="sp-lines">
        {c.lines.map((l) => {
          const href = lineHref(l.name);
          const El = href ? 'a' : 'article';
          return (
            <El class:list={['sp-line', href && 'sp-line--link']} href={href ?? undefined}>
              {lineShot(l.name) ? (
                /* A real product from that very line — the card stops being a
                   generic droplet icon and starts showing what is being sold. */
                <span class="sp-line__shot" aria-hidden="true">
                  <img src={lineShot(l.name)} alt="" loading="lazy" decoding="async" />
                </span>
              ) : (
                <span class="sp-line__ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5s6 6.8 6 11.2A6 6 0 0 1 6 13.7C6 9.3 12 2.5 12 2.5Z"/></svg>
                </span>
              )}
              <h3 class="sp-line__nm">{l.name}</h3>
              <p class="sp-line__note">{l.note}</p>
              {href && <span class="sp-line__more">{c.ui.more}</span>}
            </El>
          );
        })}
      </div>
    </div>
  </section>

  <!-- PRODUCT CATALOG -->
  {profile.catalog && profile.catalog.length > 0 && (
    <section class="sp-sec">
      <div class="wrap">
        <span class="sp-lvl">{c.ui.catalog_h}</span>
        <div class="sp-catalog">
          {profile.catalog.map((grp, gi) => {
            const base = profile.catalog!.slice(0, gi).reduce((s, g) => s + g.items.length, 0);
            return (
              <div class="sp-catgrp">
                <div class="sp-catgrp__head">
                  <h3 class="sp-catgrp__nm">
                    {lineHref(grp.line) ? <a class="sp-catgrp__lnk" href={lineHref(grp.line)}>{grp.line}</a> : grp.line}
                  </h3>
                  <div class="sp-catnav">
                    <button class="sp-catnav__b" type="button" data-dir="-1" aria-label={t.common.prev}>‹</button>
                    <button class="sp-catnav__b" type="button" data-dir="1" aria-label={t.common.next}>›</button>
                  </div>
                </div>
                <div class="sp-catgrp__grid">
                  {grp.items.map((it, ii) => {
                    const note = c.catalog_notes?.[base + ii];
                    return (
                      <button class="sp-prod" type="button" data-full={it.img} data-name={it.name}>
                        <span class="sp-prod__ph"><img src={it.img} alt={it.name} loading="lazy" decoding="async" /></span>
                        <span class="sp-prod__body">
                          <span class="sp-prod__nm">{it.name}{it.volume && <span class="sp-prod__vol"> · {it.volume}</span>}</span>
                          {note && <span class="sp-prod__desc">{note}</span>}
                          {it.certs && it.certs.length > 0 && (
                            <span class="sp-prod__certs">{it.certs.map((cc) => <span>{cc}</span>)}</span>
                          )}
                          {it.price && <span class="sp-prod__price">≈ ${it.price}</span>}
                        </span>
                      </button>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- SIGNATURE TECH -->
  {c.tech?.length > 0 && (
    <section class="sp-sec">
      <div class="wrap">
        <span class="sp-lvl">{c.ui.tech_h}</span>
        <div class="sp-tech">
          {c.tech.map((tItem) => (
            <article class="sp-tech__item">
              <h3 class="sp-tech__nm">{tItem.name}</h3>
              <p class="sp-tech__note">{tItem.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CERTIFICATIONS -->
  {profile.certs && profile.certs.length > 0 && (
    <section class="sp-sec">
      <div class="wrap sp-narrow">
        <span class="sp-lvl">{c.ui.certs_h}</span>
        <ul class="sp-certs">{profile.certs.map((cert) => <li>{cert}</li>)}</ul>
        {c.ui.certs_note && <p class="sp-certs__note">{c.ui.certs_note}</p>}
      </div>
    </section>
  )}

  <!-- PRODUCT SHOWCASE -->
  {m && (
    <section class="sp-sec sp-sec--tint">
      <div class="wrap sp-showcase">
        <figure class="sp-showcase__img">
          <Image src={m.products} alt={`${profile.brand} — ${c.ui.products_h}`} widths={[520, 960]} sizes="(max-width: 820px) 92vw, 480px" format="webp" loading="lazy" decoding="async" />
        </figure>
        <div class="sp-showcase__text">
          <span class="sp-lvl">{c.ui.products_h}</span>
          <p class="sp-body">{c.ui.products_note}</p>
        </div>
      </div>
    </section>
  )}

  <!-- FORMATS + EXPORT -->
  <section class="sp-sec">
    <div class="wrap sp-cols">
      <div>
        <span class="sp-lvl">{c.ui.formats_h}</span>
        <ul class="sp-formats">{c.formats.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div>
        <span class="sp-lvl">{c.ui.export_h}</span>
        <p class="sp-body">{c.exportNote}</p>
      </div>
    </div>
  </section>

  <!-- TERMS -->
  {c.terms && c.terms.length > 0 && (
    <section class="sp-sec sp-sec--tint">
      <div class="wrap sp-narrow">
        <span class="sp-lvl">{c.ui.terms_h}</span>
        <dl class="sp-terms">
          {c.terms.map((row) => (
            <div class="sp-terms__row">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
        <div class="sp-terms__dls">
          {termsHref && (
            <a class="sp-terms__dl" href={termsHref} download>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
              {c.ui.download_btn}
            </a>
          )}
          {priceHref && c.ui.price_btn && (
            <a class="sp-terms__dl sp-terms__dl--alt" href={priceHref} download>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
              {c.ui.price_btn}
            </a>
          )}
          {presHref && c.ui.pres_btn && (
            <a class="sp-terms__dl sp-terms__dl--alt" href={presHref} download>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
              {c.ui.pres_btn}
            </a>
          )}
        </div>
        {c.ui.terms_disc && <p class="sp-terms__disc">{c.ui.terms_disc}</p>}
      </div>
    </section>
  )}

  {articles.length > 0 && (
    <section class="sp-sec">
      <div class="wrap">
        <span class="sp-lvl">{t.pages.blog.supplier_articles_h}</span>
        <div class="sp-articles">
          {articles.map((post) => {
            const ac = postContent(post, lang);
            return (
              <a class="sp-article" href={localizePath(`/blog/${post.slug}`, lang)}>
                <span class="sp-article__img">
                  {articleCovers.get(post.slug)?.products.length ? (
                    <BrandCover
                      products={articleCovers.get(post.slug)!.products}
                      mode={articleCovers.get(post.slug)!.mode === 'cards' ? 'cards' : 'float'}
                      seed={post.slug}
                      deep={profile.brandColors.deep}
                      sky={profile.brandColors.sky}
                      accent={profile.brandColors.accent}
                      bg={profile.brandColors.bg}
                    />
                  ) : post.hero ? (
                    <img src={post.hero} alt={ac.title} loading="lazy" decoding="async" />
                  ) : (
                    <svg class="sp-article__ph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5s6 6.8 6 11.2A6 6 0 0 1 6 13.7C6 9.3 12 2.5 12 2.5Z"/></svg>
                  )}
                </span>
                <span class="sp-article__txt">
                  <span class="sp-article__cat">{post.category === 'guide' ? t.pages.blog.cat_guide : t.pages.blog.cat_overview}</span>
                  <span class="sp-article__title">{ac.title}</span>
                  <span class="sp-article__more">{t.pages.blog.read_more} →</span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="sp-cta">
    <div class="wrap">
      <div class="sp-cta__card">
        {m && <Image class="sp-cta__bg" src={m.drops} alt="" widths={[900, 1400]} sizes="100vw" format="webp" loading="lazy" decoding="async" />}
        <h2 class="sp-cta__h">{c.ui.cta_h}</h2>
        <p class="sp-cta__d">{c.ui.cta_d}</p>
        <a class="btn btn--primary btn--lg" href={anchorHref('ondemand', lang)}>{c.ui.cta_btn}</a>
      </div>
      <p class="sp-consent">{c.consentNote}</p>
    </div>
  </section>

  <div class="sp-lb" id="spLb" hidden>
    <button class="sp-lb__x" type="button" aria-label="×">×</button>
    <figure class="sp-lb__fig">
      <img id="spLbImg" src="" alt="" />
      <figcaption id="spLbCap"></figcaption>
    </figure>
  </div>
</article>

<script>
  const lb = document.getElementById('spLb');
  if (lb) {
    const img = document.getElementById('spLbImg');
    const cap = document.getElementById('spLbCap');
    const open = (src, name) => { img.setAttribute('src', src); img.setAttribute('alt', name || ''); cap.textContent = name || ''; lb.hidden = false; document.documentElement.style.overflow = 'hidden'; };
    const close = () => { lb.hidden = true; img.setAttribute('src', ''); document.documentElement.style.overflow = ''; };
    document.querySelectorAll('.sp-prod, .sp-visit__i').forEach((b) => b.addEventListener('click', () => open(b.getAttribute('data-full'), b.getAttribute('data-name'))));
    lb.querySelector('.sp-lb__x').addEventListener('click', close);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lb.hidden) close(); });
  }
  document.querySelectorAll('.sp-catnav__b').forEach((b) => b.addEventListener('click', () => {
    const grp = b.closest('.sp-catgrp');
    const row = grp && grp.querySelector('.sp-catgrp__grid');
    if (!row) return;
    const card = row.querySelector('.sp-prod');
    const step = card ? (card.getBoundingClientRect().width + 14) * 2 : row.clientWidth * 0.8;
    row.scrollBy({ left: Number(b.getAttribute('data-dir')) * step, behavior: 'smooth' });
  }));
</script>

<style>
