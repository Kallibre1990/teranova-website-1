---
/* Supplier profile page — themed in the supplier's own brand colors on top of the
   Teranova chrome. First use: SANTE COSMETICS / Dr.SANTE. Light, clinical
   dermatology aesthetic (the supplier's identity), distinct from the site's navy.
   Images/logo used under the supplier's written consent (docs/CONTENT-RULES §7).
   Copy is localized per language via supplierContent(profile, lang). */
import { Image } from 'astro:assets';
import { localizePath, anchorHref } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';
import { supplierContent, type SupplierProfile } from '../../data/suppliers';
import santeLogo from '../../assets/suppliers/dr-sante-logo.png';
import santeHero from '../../assets/suppliers/sante/hero-serum.png';
import santeProducts from '../../assets/suppliers/sante/products.jpg';
import santeDrops from '../../assets/suppliers/sante/drops.jpg';

interface Props {
  lang: Lang;
  profile: SupplierProfile;
}
const { lang, profile } = Astro.props;
const t = ui[lang];
const c = supplierContent(profile, lang);
const logos: Record<string, ImageMetadata> = { sante: santeLogo };
const logo = logos[profile.slug];
const media: Record<string, { hero: ImageMetadata; products: ImageMetadata; drops: ImageMetadata }> = {
  sante: { hero: santeHero, products: santeProducts, drops: santeDrops },
};
const m = media[profile.slug];
const termsHref = profile.termsFile?.[lang] ?? profile.termsFile?.ru;
const cat = t.categories.groups.find((g) => g.key === profile.category);
const brandStyle = `--ds-deep:${profile.brandColors.deep};--ds-sky:${profile.brandColors.sky};--ds-accent:${profile.brandColors.accent};--ds-bg:${profile.brandColors.bg};`;
---

<article class="sp" style={brandStyle}>
  <!-- HERO -->
  <section class="sp-hero">
    <div class="wrap">
      <nav class="sp-crumbs" aria-label="breadcrumb">
        <a href={localizePath('/catalog', lang)}>{t.nav.catalog}</a>
        <span aria-hidden="true">/</span>
        <a href={localizePath(`/catalog/${profile.category}`, lang)}>{cat?.name}</a>
      </nav>

      <div class="sp-hero__grid">
        <div class="sp-hero__main">
          <span class="sp-eyebrow">{c.ui.profile_sup}</span>
          <figure class="sp-logo">
            {logo && <Image src={logo} alt={`${profile.brand}`} widths={[220, 440]} sizes="220px" format="webp" loading="eager" decoding="async" />}
          </figure>
          <h1 class="sp-name">{profile.name}</h1>
          <p class="sp-tagline">«{c.tagline}»</p>
          <p class="sp-descriptor">{c.descriptor}</p>
          <div class="sp-meta">
            <span class="sp-status"><span class="dot" aria-hidden="true"></span>{t.verify.card_provided_t}</span>
            <span class="sp-origin">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.5-7-11a7 7 0 0 1 14 0c0 4.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
              {c.origin}
            </span>
          </div>
        </div>
        {m && (
          <aside class="sp-hero__art">
            <figure class="sp-hero__photo">
              <Image src={m.hero} alt={`${profile.brand} — ${c.descriptor}`} widths={[440, 720]} sizes="(max-width: 820px) 92vw, 440px" format="webp" loading="eager" decoding="async" />
            </figure>
          </aside>
        )}
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="sp-sec">
    <div class="wrap sp-narrow">
      <span class="sp-lvl">{c.ui.about_h}</span>
      {c.about.map((p) => <p class="sp-body">{p}</p>)}
      <ul class="sp-facts">{c.facts.map((f) => <li>{f}</li>)}</ul>
      {c.channels?.length > 0 && (
        <div class="sp-channels">
          <span class="sp-channels__lbl">{c.ui.for_whom}</span>
          <ul class="sp-chips-inline">{c.channels.map((ch) => <li>{ch}</li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <!-- LINES -->
  <section class="sp-sec sp-sec--tint">
    <div class="wrap">
      <span class="sp-lvl">{c.ui.lines_h}</span>
      <div class="sp-lines">
        {c.lines.map((l) => (
          <article class="sp-line">
            <span class="sp-line__ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5s6 6.8 6 11.2A6 6 0 0 1 6 13.7C6 9.3 12 2.5 12 2.5Z"/></svg>
            </span>
            <h3 class="sp-line__nm">{l.name}</h3>
            <p class="sp-line__note">{l.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCT CATALOG -->
  {profile.catalog && profile.catalog.length > 0 && (
    <section class="sp-sec">
      <div class="wrap">
        <span class="sp-lvl">{c.ui.catalog_h}</span>
        <div class="sp-catalog">
          {profile.catalog.map((grp, gi) => {
            const base = profile.catalog!.slice(0, gi).reduce((s, g) => s + g.items.length, 0);
            return (
              <div class="sp-catgrp">
                <h3 class="sp-catgrp__nm">{grp.line}</h3>
                <div class="sp-catgrp__grid">
                  {grp.items.map((it, ii) => {
                    const note = c.catalog_notes?.[base + ii];
                    return (
                      <a class="sp-prod" href={it.img} target="_blank" rel="noopener">
                        <span class="sp-prod__ph"><img src={it.img} alt={it.name} loading="lazy" decoding="async" /></span>
                        <span class="sp-prod__nm">{it.name}</span>
                        {note && <span class="sp-prod__desc">{note}</span>}
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- SIGNATURE TECH -->
  {c.tech?.length > 0 && (
    <section class="sp-sec">
      <div class="wrap">
        <span class="sp-lvl">{c.ui.tech_h}</span>
        <div class="sp-tech">
          {c.tech.map((tItem) => (
            <article class="sp-tech__item">
              <h3 class="sp-tech__nm">{tItem.name}</h3>
              <p class="sp-tech__note">{tItem.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CERTIFICATIONS -->
  {profile.certs && profile.certs.length > 0 && (
    <section class="sp-sec">
      <div class="wrap sp-narrow">
        <span class="sp-lvl">{c.ui.certs_h}</span>
        <ul class="sp-certs">{profile.certs.map((cert) => <li>{cert}</li>)}</ul>
        {c.ui.certs_note && <p class="sp-certs__note">{c.ui.certs_note}</p>}
      </div>
    </section>
  )}

  <!-- PRODUCT SHOWCASE -->
  {m && (
    <section class="sp-sec sp-sec--tint">
      <div class="wrap sp-showcase">
        <figure class="sp-showcase__img">
          <Image src={m.products} alt={`${profile.brand} — ${c.ui.products_h}`} widths={[520, 960]} sizes="(max-width: 820px) 92vw, 480px" format="webp" loading="lazy" decoding="async" />
        </figure>
        <div class="sp-showcase__text">
          <span class="sp-lvl">{c.ui.products_h}</span>
          <p class="sp-body">{c.ui.products_note}</p>
        </div>
      </div>
    </section>
  )}

  <!-- FORMATS + EXPORT -->
  <section class="sp-sec">
    <div class="wrap sp-cols">
      <div>
        <span class="sp-lvl">{c.ui.formats_h}</span>
        <ul class="sp-formats">{c.formats.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div>
        <span class="sp-lvl">{c.ui.export_h}</span>
        <p class="sp-body">{c.exportNote}</p>
      </div>
    </div>
  </section>

  <!-- TERMS -->
  {c.terms && c.terms.length > 0 && (
    <section class="sp-sec sp-sec--tint">
      <div class="wrap sp-narrow">
        <span class="sp-lvl">{c.ui.terms_h}</span>
        <dl class="sp-terms">
          {c.terms.map((row) => (
            <div class="sp-terms__row">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
        {termsHref && (
          <a class="sp-terms__dl" href={termsHref} download>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
            {c.ui.download_btn}
          </a>
        )}
        {c.ui.terms_disc && <p class="sp-terms__disc">{c.ui.terms_disc}</p>}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="sp-cta">
    <div class="wrap">
      <div class="sp-cta__card">
        {m && <Image class="sp-cta__bg" src={m.drops} alt="" widths={[900, 1400]} sizes="100vw" format="webp" loading="lazy" decoding="async" />}
        <h2 class="sp-cta__h">{c.ui.cta_h}</h2>
        <p class="sp-cta__d">{c.ui.cta_d}</p>
        <a class="btn btn--primary btn--lg" href={anchorHref('ondemand', lang)}>{c.ui.cta_btn}</a>
      </div>
      <p class="sp-consent">{c.consentNote}</p>
    </div>
  </section>
</article>

<style>
  .sp { --ds-deep: #12306e; --ds-sky: #4ca6fc; --ds-accent: #ff2552; --ds-bg: #f3f8ff; background: #fff; color: #16233d; }

  /* ---- HERO ---- */
  .sp-hero {
    position: relative; padding: clamp(30px, 6vw, 60px) 0 clamp(40px, 6vw, 72px);
    background:
      radial-gradient(120% 90% at 82% -10%, color-mix(in srgb, var(--ds-sky) 22%, transparent), transparent 60%),
      linear-gradient(180deg, var(--ds-bg), #fff 78%);
    border-bottom: 1px solid color-mix(in srgb, var(--ds-sky) 22%, #e2e8f0);
  }
  .sp-crumbs { display: flex; align-items: center; gap: 9px; font-size: 0.84rem; font-weight: 600; color: #5a6a80; margin-bottom: clamp(20px, 3vw, 34px); }
  .sp-crumbs a { color: var(--ds-deep); }
  .sp-crumbs a:hover { color: var(--ds-sky); }
  .sp-crumbs span { opacity: 0.5; }

  .sp-hero__grid { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; }
  .sp-eyebrow {
    display: inline-flex; align-items: center; gap: 9px; font-size: 0.72rem; font-weight: 800;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--ds-sky); margin-bottom: 18px;
  }
  .sp-eyebrow::before { content: ''; width: 24px; height: 2px; background: currentColor; border-radius: 2px; }
  .sp-logo { margin: 0 0 20px; }
  .sp-logo :global(img) { width: auto; height: clamp(52px, 7vw, 74px); }
  .sp-name { font-size: clamp(1.9rem, 4.4vw, 3rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; color: var(--ds-deep); }
  .sp-tagline { font-size: clamp(1.05rem, 2vw, 1.28rem); font-weight: 600; font-style: italic; color: var(--ds-sky); margin-top: 12px; }
  .sp-descriptor { font-size: 1.02rem; color: #45576f; margin-top: 8px; }

  .sp-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 22px; }
  .sp-status {
    display: inline-flex; align-items: center; gap: 8px; font-size: 0.84rem; font-weight: 700;
    color: #9a6a12; background: #f7efd9; border: 1px solid #e9d8ad; border-radius: 100px; padding: 6px 14px;
  }
  .sp-status .dot { width: 7px; height: 7px; border-radius: 50%; background: #9a6a12; }
  .sp-origin { display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; font-weight: 600; color: #45576f; }

  .sp-hero__art { display: grid; place-items: center; }
  .sp-hero__photo { margin: 0; }
  .sp-hero__photo :global(img) {
    width: clamp(300px, 34vw, 440px); height: auto; border-radius: 22px;
    box-shadow: 0 26px 60px color-mix(in srgb, var(--ds-deep) 26%, transparent);
    border: 1px solid rgba(255, 255, 255, 0.7);
  }
  .sp-showcase { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(28px, 5vw, 56px); align-items: center; }
  .sp-showcase__img { margin: 0; }
  .sp-showcase__img :global(img) { width: 100%; height: auto; border-radius: 20px; box-shadow: var(--sh-m); }

  /* ---- SECTIONS ---- */
  .sp-sec { padding: clamp(40px, 6vw, 72px) 0; }
  .sp-sec--tint { background: var(--ds-bg); border-block: 1px solid color-mix(in srgb, var(--ds-sky) 16%, #e2e8f0); }
  .sp-narrow { max-width: 760px; }
  .sp-lvl { display: block; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ds-sky); margin-bottom: 16px; }
  .sp-body { font-size: 1.02rem; line-height: 1.75; color: #364357; }
  .sp-body + .sp-body { margin-top: 14px; }

  .sp-facts { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 22px; }
  .sp-facts li { font-size: 0.85rem; font-weight: 600; color: var(--ds-deep); background: #fff; border: 1px solid color-mix(in srgb, var(--ds-sky) 30%, #d4dde9); border-radius: 100px; padding: 7px 15px; }

  .sp-channels { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 12px; margin-top: 20px; }
  .sp-channels__lbl { font-size: 0.85rem; font-weight: 700; color: var(--ds-deep); }
  .sp-chips-inline { display: flex; flex-wrap: wrap; gap: 8px; }
  .sp-chips-inline li { font-size: 0.84rem; font-weight: 600; color: #45576f; background: color-mix(in srgb, var(--ds-sky) 10%, #fff); border: 1px solid color-mix(in srgb, var(--ds-sky) 24%, #d4dde9); border-radius: 100px; padding: 6px 13px; }

  .sp-catalog { display: flex; flex-direction: column; gap: 24px; }
  .sp-catgrp__nm { font-size: 1.05rem; font-weight: 800; color: var(--ds-deep); margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
  .sp-catgrp__nm::before { content: ''; width: 18px; height: 2px; background: var(--ds-sky); border-radius: 2px; }
  .sp-catgrp__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(146px, 1fr)); gap: 14px; }
  .sp-prod { display: flex; flex-direction: column; background: #fff; border: 1px solid color-mix(in srgb, var(--ds-sky) 20%, #e2e8f0); border-radius: 14px; overflow: hidden; transition: transform .2s var(--ease), box-shadow .2s; }
  .sp-prod:hover { transform: translateY(-3px); box-shadow: 0 14px 30px color-mix(in srgb, var(--ds-deep) 12%, transparent); }
  .sp-prod__ph { aspect-ratio: 1 / 1; background: #f7fafe; display: grid; place-items: center; padding: 10px; }
  .sp-prod__ph img { width: 100%; height: 100%; object-fit: contain; }
  .sp-prod__nm { padding: 10px 12px 5px; font-size: 0.82rem; font-weight: 700; color: var(--ds-deep); line-height: 1.3; }
  .sp-prod__desc { padding: 0 12px 14px; font-size: 0.75rem; color: #5a6a80; line-height: 1.45; }

  .sp-certs { display: flex; flex-wrap: wrap; gap: 9px; }
  .sp-certs li { font-size: 0.88rem; font-weight: 700; color: var(--ds-deep); background: color-mix(in srgb, var(--ds-sky) 10%, #fff); border: 1px solid color-mix(in srgb, var(--ds-sky) 30%, #d4dde9); border-radius: 8px; padding: 8px 15px; }
  .sp-certs__note { font-size: 0.82rem; color: #5a6a80; line-height: 1.55; margin-top: 14px; }

  .sp-tech { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .sp-tech__item { border-left: 3px solid var(--ds-sky); background: var(--ds-bg); border-radius: 0 14px 14px 0; padding: 20px 22px; }
  .sp-tech__nm { font-size: 1.05rem; font-weight: 800; color: var(--ds-deep); letter-spacing: -0.01em; }
  .sp-tech__note { font-size: 0.92rem; line-height: 1.6; color: #45576f; margin-top: 7px; }

  /* terms */
  .sp-terms { display: grid; gap: 2px; }
  .sp-terms__row { display: grid; grid-template-columns: 210px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid color-mix(in srgb, var(--ds-sky) 16%, #e2e8f0); }
  .sp-terms__row dt { font-weight: 700; color: var(--ds-deep); font-size: 0.92rem; }
  .sp-terms__row dd { color: #364357; font-size: 0.96rem; line-height: 1.6; }
  .sp-terms__dl { display: inline-flex; align-items: center; gap: 9px; margin-top: 24px; padding: 12px 22px; border-radius: 10px; font-weight: 700; font-size: 0.92rem; color: #fff; background: var(--ds-deep); transition: background .2s; }
  .sp-terms__dl:hover { background: var(--ds-sky); }
  .sp-terms__dl svg { width: 17px; height: 17px; }
  .sp-terms__disc { font-size: 0.82rem; color: #5a6a80; line-height: 1.6; margin-top: 16px; }

  /* lines */
  .sp-lines { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .sp-line { background: #fff; border: 1px solid color-mix(in srgb, var(--ds-sky) 24%, #e2e8f0); border-radius: 16px; padding: 24px; box-shadow: 0 1px 2px rgba(11, 27, 53, 0.04); transition: transform .2s var(--ease), box-shadow .2s; }
  .sp-line:hover { transform: translateY(-3px); box-shadow: 0 14px 34px color-mix(in srgb, var(--ds-deep) 12%, transparent); }
  .sp-line__ic { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; color: var(--ds-sky); background: color-mix(in srgb, var(--ds-sky) 12%, #fff); border: 1px solid color-mix(in srgb, var(--ds-sky) 26%, transparent); margin-bottom: 14px; }
  .sp-line__ic svg { width: 22px; height: 22px; }
  .sp-line__nm { font-size: 1.12rem; font-weight: 800; color: var(--ds-deep); letter-spacing: -0.01em; }
  .sp-line__note { font-size: 0.92rem; line-height: 1.6; color: #45576f; margin-top: 8px; }

  /* formats + export */
  .sp-cols { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(28px, 5vw, 56px); }
  .sp-formats { display: flex; flex-wrap: wrap; gap: 9px; }
  .sp-formats li { font-size: 0.9rem; font-weight: 600; color: var(--ds-deep); background: var(--ds-bg); border: 1px solid color-mix(in srgb, var(--ds-sky) 24%, #d4dde9); border-radius: 10px; padding: 8px 14px; }

  /* CTA */
  .sp-cta { padding: 0 0 clamp(56px, 8vw, 90px); }
  .sp-cta__card {
    position: relative; overflow: hidden; border-radius: 24px; padding: clamp(32px, 5vw, 52px); text-align: center; color: #fff;
    background: linear-gradient(135deg, var(--ds-deep), color-mix(in srgb, var(--ds-sky) 70%, var(--ds-deep)));
    box-shadow: 0 26px 60px color-mix(in srgb, var(--ds-deep) 34%, transparent);
  }
  .sp-cta__card::after { content: ''; position: absolute; inset: 0; background: radial-gradient(80% 120% at 88% -20%, color-mix(in srgb, var(--ds-accent) 42%, transparent), transparent 60%); pointer-events: none; z-index: 1; }
  .sp-cta__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.24; z-index: 0; }
  .sp-cta__h { position: relative; z-index: 2; font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 800; letter-spacing: -0.02em; }
  .sp-cta__d { position: relative; z-index: 2; font-size: 1.02rem; line-height: 1.65; color: rgba(255, 255, 255, 0.9); max-width: 54ch; margin: 12px auto 24px; }
  .sp-cta__card .btn { position: relative; z-index: 2; }
  .sp-consent { font-size: 0.82rem; line-height: 1.6; color: #5a6a80; text-align: center; max-width: 70ch; margin: 22px auto 0; }

  @media (max-width: 820px) {
    .sp-hero__grid { grid-template-columns: 1fr; }
    .sp-hero__photo :global(img) { width: 100%; max-width: 460px; }
    .sp-lines { grid-template-columns: 1fr; }
    .sp-cols { grid-template-columns: 1fr; }
    .sp-showcase { grid-template-columns: 1fr; }
    .sp-tech { grid-template-columns: 1fr; }
    .sp-terms__row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
