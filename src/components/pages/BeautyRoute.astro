---
/* Коммерческий маршрут витрины Beauty: четыре задачи покупателя, затем
 * 6–8 смысловых историй, и только после них полный каталог.
 *
 * Почему так. Раньше сразу под первым экраном стояла кнопка «Запустить
 * бьюти-бренд»: первый экран звал подобрать готовый ассортимент, а
 * следующий тут же тянул в свою марку. Два сценария спорили друг с другом.
 *
 * Сцены у каждой задачи разные и по смыслу своего раздела — требование
 * Антона от 06.09.2026. Источники честные: настоящие снимки товара
 * поставщиков там, где речь о товаре и упаковке, и наши редакционные
 * иллюстрации там, где речь об общем процессе. Ни одна сцена не выдаётся
 * за доказательство визита к конкретному поставщику.
 */
import { localizePath, anchorHref } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';
import { suppliers, supplierContent, showcaseImages } from '../../data/suppliers';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const shots = (slug: string, n: number) => {
  const s = suppliers.find((x) => x.slug === slug);
  return s ? showcaseImages(s, n) : [];
};

/* Четыре входа по коммерческой задаче. Сцена у каждого своя. */
const tasks = [
  {
    key: 'ready',
    sup: 'Задача 01',
    title: 'Готовый бренд для дистрибуции',
    desc: 'Корейские марки и продуктовые линейки, которые можно поставить на полку. Коммерческие условия подтверждаем по запросу.',
    images: [...shots('sante', 2), ...shots('licorne', 2)].slice(0, 4),
    kind: 'photo' as const,
  },
  {
    key: 'own',
    sup: 'Задача 02',
    title: 'Своя марка · OEM и ODM',
    desc: 'Подбор производителя под вашу рецептуру, объём и рынок: от образца до документов и отгрузки.',
    art: '/img/blog/editorial/oem-odm-process.webp',
    kind: 'art' as const,
  },
  {
    key: 'pro',
    sup: 'Задача 03',
    title: 'Профессиональная линия',
    desc: 'Ассортимент для кабинетов и клиник: маски, ампулы, аппаратный уход, программы для салонов.',
    images: [...shots('icelmedi', 2), ...shots('doobom', 2)].slice(0, 4),
    kind: 'photo' as const,
  },
  {
    key: 'pack',
    sup: 'Задача 04',
    title: 'Упаковка и сырьё',
    desc: 'Стекло, помпы, тубы и банки корейского производства; стандартизованные активы с заявленной чистотой.',
    images: shots('cocospack', 4),
    kind: 'photo' as const,
  },
];

/* Шесть-восемь отобранных историй. Не весь каталог: сначала повод открыть,
   потом полный список ниже по странице. Описание берётся из данных
   профиля, а не сочиняется здесь. */
const STORY_SLUGS = ['sante', 'dreamcos', 'dongdonggurimoo', 'icelmedi', 'licorne', 'three-days-love', 'cocospack', 'joycos'];
const stories = STORY_SLUGS.map((slug) => {
  const s = suppliers.find((x) => x.slug === slug);
  if (!s) return null;
  const c = supplierContent(s, lang);
  return { s, c, imgs: showcaseImages(s, 3) };
}).filter((x): x is NonNullable<typeof x> => Boolean(x));

const statusInfo = {
  visited: { cls: 'badge--visited', label: t.verify.card_visited_t },
  provided: { cls: 'badge--provided', label: t.verify.card_provided_t },
} as const;
const countryFlag: Record<string, string> = { kr: '🇰🇷', cn: '🇨🇳', in: '🇮🇳' };
---

<section class="section section--navy br">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">С чего начать</span>
      <h2 class="h-section">Четыре задачи, с которыми к нам приходят</h2>
      <p class="sub-section">Выберите свою — покажем то, что к ней относится, и вернёмся с условиями.</p>
    </div>

    <div class="br-tasks">
      {tasks.map((task) => (
        <a class="br-task" href={anchorHref('ondemand', lang)}>
          <span class="br-task__scene">
            {task.kind === 'photo'
              ? <span class="br-task__grid">{task.images.map((src) => (<span class="br-task__pad"><img src={src} alt="" loading="lazy" decoding="async" /></span>))}</span>
              : <img class="br-task__art" src={task.art} alt="" loading="lazy" decoding="async" />}
          </span>
          <span class="br-task__body">
            <span class="lvl">{task.sup}</span>
            <span class="br-task__t">{task.title}</span>
            <span class="br-task__d">{task.desc}</span>
            <span class="br-task__go">Обсудить задачу →</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section section--navy br br--stories bsc bsc--verify" id="stories">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Отобранные истории</span>
      <h2 class="h-section">Восемь компаний, с которых удобно начать</h2>
      <p class="sub-section">
        Не весь каталог сразу: сначала те, у кого понятная специализация и есть
        что показать. Полный список из всех компаний — ниже на странице.
      </p>
    </div>

    <div class="br-stories">
      {stories.map(({ s, c, imgs }) => (
        <a class="br-story" href={localizePath(`/catalog/${s.slug}`, lang)}>
          <span class="br-story__head">
            <span class={`badge ${statusInfo[s.status].cls}`}><span class="dot" />{statusInfo[s.status].label}</span>
            <span class="br-story__geo">{countryFlag[s.country ?? 'kr']}</span>
          </span>
          <span class="br-story__nm">{s.name}</span>
          <span class="br-story__desc">{c.descriptor}</span>
          {imgs.length > 0 && (
            <span class="br-story__shots">
              {imgs.map((src) => (<span class="br-story__pad"><img src={src} alt="" loading="lazy" decoding="async" /></span>))}
            </span>
          )}
          <span class="br-story__go">{c.ui.more}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .br-tasks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .br-task {
    display: flex; flex-direction: column; overflow: hidden;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(203, 212, 224, 0.16);
    border-radius: 6px;
    transition: transform .2s var(--ease), border-color .2s, background .2s;
  }
  .br-task:hover { transform: translateY(-3px); border-color: rgba(200, 168, 106, 0.5); background: rgba(255, 255, 255, 0.075); }
  /* Сцена задачи — своя у каждой карточки и всегда сверху, отдельной зоной.
     Так кадр не лежит под текстом и не мешает читать. */
  .br-task__scene { display: block; background: #f3f5f8; }
  .br-task__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: #e4e9f0; }
  .br-task__pad { background: #f6f8fb; aspect-ratio: 1 / 1; display: grid; place-items: center; overflow: hidden; }
  .br-task__pad img { width: 86%; height: 86%; object-fit: contain; display: block; }
  .br-task__art { width: 100%; aspect-ratio: 4 / 1; object-fit: cover; display: block; }
  .br-task__body { display: flex; flex-direction: column; padding: 22px 24px 24px; gap: 8px; }
  .br-task__t { font-size: 1.22rem; font-weight: 700; letter-spacing: -0.02em; }
  .br-task__d { font-size: 0.94rem; line-height: 1.6; }
  .br-task__go { margin-top: 8px; font-size: 0.88rem; font-weight: 700; }

  .br-stories { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .br-story {
    display: flex; flex-direction: column; gap: 10px; padding: 18px;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(203, 212, 224, 0.16);
    border-radius: 6px;
    transition: transform .2s var(--ease), border-color .2s, background .2s;
  }
  .br-story:hover { transform: translateY(-3px); border-color: rgba(200, 168, 106, 0.5); background: rgba(255, 255, 255, 0.075); }
  .br-story__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .br-story__geo { font-size: 0.9rem; }
  .br-story__nm { font-size: 1.02rem; font-weight: 800; letter-spacing: -0.015em; line-height: 1.25; }
  .br-story__desc { font-size: 0.86rem; line-height: 1.5; }
  .br-story__shots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; margin-top: 2px; }
  .br-story__pad { background: #f3f5f8; border-radius: 4px; aspect-ratio: 1 / 1; display: grid; place-items: center; overflow: hidden; }
  .br-story__pad img { width: 84%; height: 84%; object-fit: contain; display: block; }
  .br-story__go { margin-top: auto; padding-top: 6px; font-size: 0.86rem; font-weight: 700; }

  @media (max-width: 1100px) { .br-stories { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 820px) {
    .br-tasks { grid-template-columns: 1fr; }
    .br-task__art { aspect-ratio: 3 / 1; }
  }
  @media (max-width: 520px) { .br-stories { grid-template-columns: 1fr; } }
</style>
