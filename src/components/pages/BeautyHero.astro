---
/* Первый экран витрины Beauty.
 *
 * Требования, из-за которых он написан отдельно от общего PageHead:
 * 1. Главное действие «Подобрать бренд и ассортимент» должно быть видно
 *    целиком на 320, 390 и 1440 без прокрутки.
 * 2. На витрине должен быть виден смысл, а не только текст.
 * 3. Разговор начинается с подбора готового ассортимента; своя марка —
 *    второй, более спокойный путь. Решение Антона от 06.09.2026.
 *
 * Про фон. Прошли три круга. Пёстрая витрина сывороток — «перегружает».
 * Безымянная упаковка в нейтральной гамме — «слишком бюджетно и не броско»,
 * и это справедливо: пустые ёмкости читаются как мокапы каталога упаковки.
 * Вывод, который стоит помнить: дороговизну в бьюти делает не количество
 * предметов, а материал, свет и фактура.
 *
 * Сейчас на превью стоят десять кандидатов-сюжетов. Это черновики для выбора
 * направления, desktop control masters 1200×675; самостоятельный вертикальный
 * кадр отрисуем только для того сюжета, который выберет Антон.
 *
 * Про достоверность. Все кадры — `generated-editorial`, происхождение в
 * docs/IMAGERY-MANIFEST.md. Ни один не изображает реальное производство,
 * товар, лабораторию или сотрудника конкретного поставщика. Доказательство
 * ширины ассортимента — «26 компаний в каталоге» и профили ниже.
 */
import { anchorHref, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { beautySuppliers } from '../../data/suppliers';
import { heroVariants, DEFAULT_HERO } from '../../data/hero-variants';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="bh" data-scene>
  <span class="bh__scene">
    <img
      src={`/img/beauty/heroes/hero-${DEFAULT_HERO}-1200.webp`}
      srcset={`/img/beauty/heroes/hero-${DEFAULT_HERO}-800.webp 800w, /img/beauty/heroes/hero-${DEFAULT_HERO}-1200.webp 1200w`}
      sizes="100vw"
      width="1200"
      height="675"
      alt=""
      fetchpriority="high"
      decoding="async"
      data-hero-img
    />
  </span>

  <div class="wrap bh__wrap">
    <div class="bh__text">
      <span class="bh__sup">Teranova Beauty · B2B</span>
      <h1 class="bh__h">Корейские бренды и продукты для вашего рынка</h1>
      <p class="bh__d">
        Подбираем бренды, продуктовые линейки и производителей под ваш рынок,
        канал продаж и бюджет.
      </p>
      <div class="bh__acts">
        <a class="btn btn--primary" href={anchorHref('ondemand', lang)}>Подобрать бренд и ассортимент</a>
        <a class="btn btn--outline" href={anchorHref('ondemand', lang)}>Обсудить свою марку</a>
      </div>
      <a class="bh__scroll" href={localizePath('/catalog/cosmetics', lang) + '#brands'}>{beautySuppliers.length} компаний в каталоге</a>
    </div>

    {/* Служебный переключатель. Он не часть сайта: скрипт показывает его
        только на превью-адресах *.pages.dev, в разметке он стоит с hidden.
        Нужен, чтобы Антон сравнивал сюжеты вживую и назвал номер. */}
    <div class="hpick" hidden data-hero-pick>
      <span class="hpick__t">Фон первого экрана</span>
      <div class="hpick__row">
        {heroVariants.map((v) => (
          <button
            class="hpick__b"
            type="button"
            data-hero-n={String(v.n)}
            aria-pressed="false"
            title={v.note}
          >{v.n}</button>
        ))}
      </div>
      <span class="hpick__name" data-hero-name></span>
    </div>

  </div>

  </section>

<script is:inline define:vars={{ variants: heroVariants, fallback: DEFAULT_HERO }}>
  /* Источник правды — адрес: ?hero=1…10. Так вариант открывается прямой
     ссылкой и отправляется с телефона. Выбор дублируется в sessionStorage,
     чтобы переход по внутренним ссылкам не сбрасывал сюжет; cookie не
     ставим и в боевую функциональность это не превращаем. */
  (() => {
    const KEY = 'tn-hero';
    const img = document.querySelector('[data-hero-img]');
    const pick = document.querySelector('[data-hero-pick]');
    if (!img) return;
    const known = new Map(variants.map((v) => [String(v.n), v]));

    const apply = (n, push) => {
      const v = known.get(String(n));
      if (!v) return;
      img.srcset = `/img/beauty/heroes/hero-${v.n}-800.webp 800w, /img/beauty/heroes/hero-${v.n}-1200.webp 1200w`;
      img.src = `/img/beauty/heroes/hero-${v.n}-1200.webp`;
      try { sessionStorage.setItem(KEY, String(v.n)); } catch {}
      if (pick) {
        for (const b of pick.querySelectorAll('[data-hero-n]')) {
          const on = b.dataset.heroN === String(v.n);
          b.classList.toggle('is-on', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        const name = pick.querySelector('[data-hero-name]');
        if (name) name.textContent = `${v.n} · ${v.label}`;
      }
      if (push) {
        const u = new URL(location.href);
        u.searchParams.set('hero', String(v.n));
        history.replaceState(null, '', u);
      }
    };

    const fromUrl = new URL(location.href).searchParams.get('hero');
    let saved = null;
    try { saved = sessionStorage.getItem(KEY); } catch {}
    const start = known.has(String(fromUrl)) ? fromUrl : (known.has(String(saved)) ? saved : fallback);
    apply(start, false);

    if (pick && location.hostname.endsWith('.pages.dev')) {
      pick.hidden = false;
      apply(start, false);
      pick.addEventListener('click', (e) => {
        const b = e.target.closest('[data-hero-n]');
        if (b) apply(b.dataset.heroN, true);
      });
    }
  })();
</script>

<style>
  /* svh, а не vh: на телефоне адресная строка съедает часть экрана, и на vh
     кнопка уехала бы под сгиб. */
  .bh {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(520px, 76svh, 760px);
    padding: clamp(28px, 4vw, 56px) 0 clamp(32px, 4vw, 64px);
    background: var(--b-velvet, #071224);
  }

  .bh__scene { position: absolute; inset: 0; z-index: -2; display: block; }
  .bh__scene img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    display: block;
    transform: translate3d(0, calc(var(--bsc-y, 0) * 3%), 0) scale(1.04);
    will-change: transform;
  }

  /* Затемнение слева, где стоит текст. У всех десяти кадров сюжет справа, а
     слева оставлено спокойное поле, поэтому шторка мягкая — она страхует
     контраст, а не гасит кадр. */
  .bh::before {
    content: '';
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgba(7,18,36,0.9) 0%, rgba(7,18,36,0.74) 34%, rgba(7,18,36,0.34) 54%, rgba(7,18,36,0.08) 72%, transparent 88%);
  }

  .bh__wrap { position: relative; z-index: 1; width: 100%; }
  .bh__text { display: flex; flex-direction: column; align-items: flex-start; max-width: 46ch; }
  .bh__sup { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--b-sub, #5f5d59); }
  /* Кегль ограничен сверху сознательно: заголовок обязан уместиться в три
     строки и оставить место действию. */
  .bh__h { font-size: clamp(1.9rem, 4vw, 3.4rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.04; color: var(--b-ink, #1b1b1a); margin: 14px 0 0; max-width: 15ch; text-wrap: balance; }
  .bh__d { font-size: clamp(0.98rem, 1.1vw, 1.1rem); line-height: 1.6; color: var(--b-sub, #5f5d59); margin: 16px 0 0; max-width: 38ch; }
  .bh__acts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: clamp(20px, 2.4vw, 30px); }
  .bh__acts .btn { min-height: 48px; }
  .bh__scroll { margin-top: 16px; font-size: 0.84rem; font-weight: 700; color: var(--b-sub, #5f5d59); border-bottom: 1px solid var(--b-line, #e6e4e0); padding-bottom: 3px; }

  /* Панель выбора. Намеренно служебная на вид: она инструмент согласования,
     а не элемент дизайна, и не должна мешать оценивать сам экран. */
  /* Панель прижата к правому нижнему углу текстовой сетки.
     `position: fixed` здесь не работает: у секции `overflow: hidden`, и
     закреплённый потомок обрезается её контекстом — Codex замерил панель на
     836–884 при секции до 757, то есть она лежала за границей и была не
     видна вовсе. Абсолютное положение внутри `.wrap` держит её в первом
     экране, справа от текста, не трогая сравниваемую геометрию. */
  .hpick {
    position: absolute;
    left: auto; right: 0; bottom: 0;
    z-index: 4;
    display: flex; align-items: center; flex-wrap: wrap;
    gap: 8px;
    max-width: min(100%, 420px);
    padding: 8px 10px;
    border-radius: 6px;
    background: rgba(6, 15, 30, 0.84);
    border: 1px solid rgba(203, 212, 224, 0.22);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .hpick__t { font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(203, 212, 224, 0.66); }
  .hpick__row { display: flex; flex-wrap: wrap; gap: 4px; max-width: 100%; }
  .hpick__b {
    flex: 0 0 auto;
    font: inherit; font-size: 0.78rem; line-height: 1;
    min-width: 30px; min-height: 30px;
    padding: 0 8px;
    border-radius: 4px; cursor: pointer;
    color: var(--b-silver, #cbd4e0);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(203, 212, 224, 0.2);
    transition: border-color .18s, color .18s, background .18s;
  }
  .hpick__b:hover { border-color: rgba(200, 168, 106, 0.6); color: #dcc189; }
  .hpick__b:focus-visible { outline: 2px solid #dcc189; outline-offset: 2px; }
  .hpick__b.is-on {
    color: #10203a; font-weight: 700;
    background: linear-gradient(180deg, #c2a05e 0%, #ab8544 100%);
    border-color: #c2a05e;
  }
  .hpick__name { font-size: 0.76rem; color: rgba(203, 212, 224, 0.8); }

  @media (max-width: 820px) {
    /* Кадры нарисованы под десктоп 16:9. Резать их по `cover` на телефоне
       нельзя: сюжет уедет за край, а текст сядет прямо на него. Поэтому
       весь кадр целиком лежит полосой внизу поверх бархата — так его видно
       и так честно сравнивать сюжеты. Верхний край растворяем маской. */
    .bh { align-items: flex-start; min-height: min(92svh, 760px); }
    .bh__scene { top: auto; bottom: 0; height: auto; }
    .bh__scene img {
      position: static;
      width: 100%; height: auto;
      object-fit: contain;
      transform: translate3d(0, calc(var(--bsc-y, 0) * 1.5%), 0);
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 24%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 24%);
    }
    .bh::before {
      background: linear-gradient(180deg, rgba(7,18,36,0.7) 0%, rgba(7,18,36,0.4) 46%, transparent 72%);
    }
    .bh__text { max-width: none; }
    .bh__acts { width: 100%; }
    .bh__acts .btn { flex: 1 1 auto; justify-content: center; }
    /* В потоке, а не поверх кадра: иначе панель закрывает сюжет, который и
       надо оценивать. */
    .hpick { position: static; margin-top: 18px; max-width: 100%; }
    /* Все десять номеров видны сразу, двумя рядами по пять. Прежде строка
       прокручивалась внутри себя, полоса прокрутки была скрыта, и до
       десятого варианта нельзя было догадаться добраться. */
    .hpick__row { max-width: 180px; }
    .hpick__b { width: 32px; min-width: 32px; padding: 0; }
  }
  @media (max-width: 460px) {
    .bh__h { font-size: clamp(1.65rem, 8.4vw, 2rem); }
    .bh__d { font-size: 0.95rem; }
    .bh__acts { flex-direction: column; }
    .bh__acts .btn { width: 100%; }
  }
</style>
