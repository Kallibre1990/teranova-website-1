---
/* Первый экран витрины Beauty.
 *
 * Требования, из-за которых он написан отдельно от общего PageHead:
 * 1. Главное действие «Подобрать бренд и ассортимент» должно быть видно
 *    целиком на 320, 390 и 1440 без прокрутки.
 * 2. На витрине должен быть виден товар, а не только текст.
 * 3. Разговор начинается с подбора готового ассортимента; своя марка —
 *    второй, более спокойный путь. Решение Антона от 06.09.2026.
 *
 * Про сцену. Раньше кадр лежал узкой полосой внизу, а поверх него стояли
 * четыре белые плашки — Антон назвал это «не красиво обрезано», и он прав:
 * от сюжета оставались стеллажи. Теперь сцена занимает экран целиком, у
 * десктопа и телефона отдельные кадры (16:9 и 9:16), и текст стоит не на
 * кадре, а на ровном тёмно-синем поле, которое заложено в саму композицию.
 *
 * Про достоверность. Сцена — редакционная иллюстрация (`generated-editorial`,
 * происхождение записано в docs/IMAGERY-MANIFEST.md). Она ничего не
 * доказывает и не изображает конкретного поставщика.
 *
 * Полосу «настоящие снимки товара» с подписью отсюда убрал: Антон 06.09.2026
 * назвал её ужасной, и по делу — четыре белые плашки с мелким товаром и
 * канцелярская надпись читались как наклейка поверх бархата. Настоящий товар
 * показывает следующий экран (четыре задачи покупателя) и карточки
 * поставщиков ниже: там он стоит на своей светлой подложке и смотрится.
 */
import { anchorHref, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { beautySuppliers } from '../../data/suppliers';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

---

<section class="bh" data-scene>
  <picture class="bh__scene">
    <source
      media="(max-width: 820px)"
      srcset="/img/beauty/scenes/hero-mobile-600.webp 600w, /img/beauty/scenes/hero-mobile-900.webp 900w"
      sizes="100vw"
    />
    <img
      src="/img/beauty/scenes/hero-desktop-1600.webp"
      srcset="/img/beauty/scenes/hero-desktop-900.webp 900w, /img/beauty/scenes/hero-desktop-1600.webp 1600w"
      sizes="100vw"
      width="1672"
      height="941"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="wrap bh__wrap">
    <div class="bh__text">
      <span class="bh__sup">Teranova Beauty · B2B</span>
      <h1 class="bh__h">Корейские бренды и продукты для вашего рынка</h1>
      <p class="bh__d">
        Подбираем бренды, продуктовые линейки и производителей под ваш рынок,
        канал продаж и бюджет.
      </p>
      <div class="bh__acts">
        <a class="btn btn--primary" href={anchorHref('ondemand', lang)}>Подобрать бренд и ассортимент</a>
        <a class="btn btn--outline" href={anchorHref('ondemand', lang)}>Обсудить свою марку</a>
      </div>
      <a class="bh__scroll" href={localizePath('/catalog/cosmetics', lang) + '#brands'}>{beautySuppliers.length} компаний в каталоге</a>

    </div>
  </div>
</section>

<style>
  /* svh, а не vh: на телефоне адресная строка съедает часть экрана, и на vh
     кнопка снова уехала бы под сгиб. */
  .bh {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(520px, 76svh, 760px);
    padding: clamp(28px, 4vw, 56px) 0 clamp(32px, 4vw, 64px);
    background: var(--b-velvet, #071224);
  }

  /* Сцена лежит слоем, а не фоном секции: так у неё есть width/height,
     нет скачка вёрстки и работает srcset с отдельным кадром для телефона. */
  .bh__scene { position: absolute; inset: 0; z-index: -2; display: block; }
  .bh__scene img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    display: block;
    /* Увеличение от левого края: тёмное поле под текстом расширяется, а
       товарная группа уходит правее и не спорит с заголовком. При `cover`
       object-position по горизонтали здесь ничего не решает — кадр уже, чем
       окно, обрезается только по высоте. Плюс запас на сдвиг при параллаксе. */
    transform-origin: 0% 50%;
    transform: translate3d(0, calc(var(--bsc-y, 0) * 4%), 0) scale(1.16);
    will-change: transform;
  }

  /* Затемнение ровно там, где стоит текст. Кадр нарисован с пустым тёмным
     полем слева, поэтому шторка почти не гасит цвет — она только гарантирует
     контраст, если браузер обрежет кадр иначе. */
  .bh::before {
    content: '';
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgba(7,18,36,0.96) 0%, rgba(7,18,36,0.93) 38%, rgba(7,18,36,0.62) 54%, rgba(7,18,36,0.16) 72%, transparent 88%);
  }

  /* .bh — flex-контейнер, поэтому .wrap как flex-элемент сжимался по
     содержимому: текст уезжал к центру, а слева оставалось пустое поле
     в 470 px. width: 100% возвращает обычную сетку страницы. */
  .bh__wrap { position: relative; z-index: 1; width: 100%; }
  .bh__text { display: flex; flex-direction: column; align-items: flex-start; max-width: 46ch; }
  .bh__sup { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--b-sub, #5f5d59); }
  /* Кегль ограничен сверху сознательно: заголовок обязан уместиться в три
     строки и оставить место действию. */
  .bh__h { font-size: clamp(1.9rem, 4vw, 3.4rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.04; color: var(--b-ink, #1b1b1a); margin: 14px 0 0; max-width: 15ch; text-wrap: balance; }
  .bh__d { font-size: clamp(0.98rem, 1.1vw, 1.1rem); line-height: 1.6; color: var(--b-sub, #5f5d59); margin: 16px 0 0; max-width: 38ch; }
  .bh__acts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: clamp(20px, 2.4vw, 30px); }
  .bh__acts .btn { min-height: 48px; }
  .bh__scroll { margin-top: 16px; font-size: 0.84rem; font-weight: 700; color: var(--b-sub, #5f5d59); border-bottom: 1px solid var(--b-line, #e6e4e0); padding-bottom: 3px; }

  @media (max-width: 820px) {
    /* Кадр для телефона вертикальный: верхние 58% — спокойный бархат под
       заголовок, товар целиком в нижней трети. Текст прижат к верху, чтобы
       кнопка не уехала за сгиб. */
    .bh { align-items: flex-start; min-height: min(94svh, 780px); }
    /* Вертикальный кадр держим за низ: товар нарисован в нижней трети, и
       увеличение от левого края уводило его за границу экрана. */
    .bh__scene img { transform-origin: 50% 100%; transform: translate3d(0, calc(var(--bsc-y, 0) * 2%), 0) scale(1.04); }
    .bh::before {
      background: linear-gradient(180deg, rgba(7,18,36,0.95) 0%, rgba(7,18,36,0.93) 44%, rgba(7,18,36,0.8) 60%, rgba(7,18,36,0.3) 78%, transparent 94%);
    }
    .bh__text { max-width: none; }
    .bh__acts { width: 100%; }
    .bh__acts .btn { flex: 1 1 auto; justify-content: center; }
  }
  @media (max-width: 460px) {
    .bh__h { font-size: clamp(1.65rem, 8.4vw, 2rem); }
    .bh__d { font-size: 0.95rem; }
    .bh__acts { flex-direction: column; }
    .bh__acts .btn { width: 100%; }
  }
</style>
