---
/* Блок на главной: бьюти-направление как ЦЕПОЧКА, а не одна категория.
   Косметика — приоритет, но отдельный блок только про неё выглядит перекосом
   на странице, которая обслуживает семь направлений. Поэтому показываем рынок
   целиком: сама косметика, сырьё и активы, упаковка, девайсы, медэстетика —
   то есть несколько наших направлений, сходящихся в одном растущем рынке.
   Ниже — ссылка на каталог, где остальные направления.

   Все строки взяты из существующего словаря pages.cosmetics (блок eco_*) и
   pages.group.back — новых текстов не вводим, переводы на 11 языков готовы. */
import Atmosphere from '../visual/Atmosphere.astro';
import { localizePath } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const c = t.pages.cosmetics;
---

<section class="section section--alt beauty" id="beauty">
  <Atmosphere variant="light" />
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{c.intro_sup}</span>
      <h2 class="h-section">{c.eco_title}</h2>
      <p class="sub-section">{c.eco_note}</p>
    </div>

    <div class="beauty__grid">
      {
        c.eco_items.map((it) => (
          <article class="bitem">
            <h3 class="bitem__t">{it.t}</h3>
            <p class="bitem__d">{it.d}</p>
          </article>
        ))
      }
    </div>

    <div class="beauty__foot">
      <a class="btn btn--primary" href={localizePath('/catalog/cosmetics', lang)}>{c.cta_primary}</a>
      <a class="link-arrow" href={localizePath('/catalog', lang)}>
        {t.pages.group.back}
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .beauty { position: relative; }
  .beauty__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .bitem {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
    padding: 22px 20px; box-shadow: var(--sh-s);
  }
  .bitem__t { font-size: 1.02rem; font-weight: 800; letter-spacing: -0.01em; color: var(--ink); margin-bottom: 7px; }
  .bitem__d { font-size: 0.88rem; color: var(--sub); line-height: 1.6; }
  .beauty__foot { margin-top: 28px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  @media (max-width: 900px) { .beauty__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .beauty__grid { grid-template-columns: 1fr; } }
</style>
