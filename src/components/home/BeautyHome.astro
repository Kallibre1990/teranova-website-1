---
/* Блок «косметика» на главной. Косметика — приоритетное направление, но на
   первом экране её не было вовсе: K-beauty упоминалась один раз на всю страницу.
   Блок стоит сразу под первым экраном, до каталога.
   Все строки взяты из уже существующего словаря pages.cosmetics — новых текстов
   не вводим, поэтому переводы на все языки готовы и вычитывать нечего. */
import Atmosphere from '../visual/Atmosphere.astro';
import { localizePath } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const c = t.pages.cosmetics;
---

<section class="section section--alt beauty" id="beauty">
  <Atmosphere variant="light" />
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{c.intro_sup}</span>
      <h2 class="h-section">{c.intro_title}</h2>
      <p class="sub-section">{c.models_sub}</p>
    </div>

    <div class="beauty__grid">
      {
        c.models.map((m) => (
          <article class="bmodel">
            <h3 class="bmodel__n">{m.name}</h3>
            <p class="bmodel__d">{m.desc}</p>
          </article>
        ))
      }
    </div>

    <div class="beauty__foot">
      <a class="btn btn--primary" href={localizePath('/catalog/cosmetics', lang)}>{c.cta_primary}</a>
    </div>
  </div>
</section>

<style>
  .beauty { position: relative; }
  .beauty__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .bmodel {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
    padding: 26px 24px; box-shadow: var(--sh-s);
  }
  .bmodel__n { font-size: 1.14rem; font-weight: 800; letter-spacing: -0.01em; color: var(--ink); margin-bottom: 10px; }
  .bmodel__d { font-size: 0.92rem; color: var(--sub); line-height: 1.65; }
  .beauty__foot { margin-top: 30px; }
  @media (max-width: 820px) { .beauty__grid { grid-template-columns: 1fr; gap: 16px; } }
</style>
