---
import { localizePath, getAlternates } from '../i18n/utils';
import { defaultLang, homeDefaultLang, type Lang } from '../i18n/ui';
import { localeDefinitions, isRootEnglishPath } from '../i18n/locale-policy.mjs';

interface Props {
  lang: Lang;
  /** Logical (default-locale) path, e.g. '/' or '/catalog'. */
  path: string;
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  /** 'article' for blog posts (og:type + article: dates); 'website' for everything else. */
  ogType?: 'website' | 'article';
  /** ISO date (yyyy-mm-dd) — required when ogType is 'article'. */
  articlePublished?: string;
  articleModified?: string;
  /** Narrows hreflang alternates to these locales — a page that only exists
   * in a few languages (draft supplier profile awaiting approval for the
   * rest). Omitted = every verified locale, the normal case. */
  langs?: Lang[];
}
const {
  lang,
  path,
  title,
  description,
  image = '/brand/og-default.png',
  jsonLd,
  noindex = false,
  ogType = 'website',
  articlePublished,
  articleModified,
  langs,
} = Astro.props;

const siteUrl = (Astro.site?.toString() ?? 'https://teranovagroup.com/').replace(/\/$/, '');
const canonical = siteUrl + localizePath(path, lang);
const alternates = getAlternates(path, langs).map((a) => ({ ...a, abs: siteUrl + a.href }));
// The printed QR root is English. Existing non-home Russian URLs retain the
// historic Russian x-default so this homepage-only migration does not move the
// indexed section hierarchy. /catalog/medical and /catalog/agingtarget follow
// the same English-root exception as home (T-20261016-054).
const xDefault = siteUrl + localizePath(path, (path === '/' || isRootEnglishPath(path)) ? homeDefaultLang : defaultLang);
const ogImage = image.startsWith('http') ? image : siteUrl + image;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// Keep meta descriptions to ~155 chars (clean word boundary) for SERP snippets.
const metaDescription =
  description.length > 160
    ? description.slice(0, 157).replace(/\s+\S*$/, '').replace(/[\s.,;:—·]+$/, '') + '…'
    : description;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={metaDescription} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />

{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.abs} />)}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<link rel="icon" href="/favicon-v2.svg" type="image/svg+xml" />
<meta name="theme-color" content="#0b1b35" />

{/* Hero background is the LCP element on the home page — preload the WebP (other browsers fall back to the JPEG <img>). */}
{path === '/' && <link rel="preload" as="image" href="/brand/hero-bg.webp" type="image/webp" fetchpriority="high" />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Teranova Group" />
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={localeDefinitions[lang].og} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{ogType === 'article' && articlePublished && <meta property="article:published_time" content={articlePublished} />}
{ogType === 'article' && articleModified && <meta property="article:modified_time" content={articleModified} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />

<!-- Fonts: Manrope is self-hosted (woff2) via @fontsource-variable/manrope, imported
     in Base.astro — no Google Fonts CDN. Korean falls back to system Hangul fonts. -->

{jsonLdList.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}

{/* Cloudflare Web Analytics. Edge auto-install stopped injecting on this zone
    (verified 2026-08-21: the HTML rewriter still injects email-decode and the bot
    challenge, but no beacon), so the tag is kept by hand. If analytics ever goes
    quiet again, check this first: RUM went dark 2026-07-30, right after this tag
    first appeared. */}
<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "52e5db2fb4cc4ea99612c64007c69024"}'></script>
