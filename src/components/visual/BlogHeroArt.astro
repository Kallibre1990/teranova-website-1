---
/* Drawn cover for blog posts (code-only visual per docs/IMAGERY.md — no stock or
   generated photos). The motif is picked deterministically from the slug, so each
   article keeps its own look. Optional brand colours (deep / sky / accent) tint the
   cover to the supplier's palette; without them it falls back to the house cobalt. */
interface Props {
  slug: string;
  variant?: 'guide' | 'overview';
  deep?: string;
  sky?: string;
  accent?: string;
}
const { slug, variant = 'guide', deep = '#0b1b35', sky = '#3f7ae0', accent = '#2563d4' } = Astro.props;

/* Multiply a hex colour toward black (f in 0..1) — used to build the dark base
   gradient from the brand's deep colour so every cover stays legible. */
function shade(hex: string, f: number): string {
  const n = parseInt(hex.replace('#', ''), 16);
  const r = Math.round(((n >> 16) & 255) * f);
  const g = Math.round(((n >> 8) & 255) * f);
  const b = Math.round((n & 255) * f);
  return '#' + [r, g, b].map((x) => x.toString(16).padStart(2, '0')).join('');
}
const base1 = shade(deep, 0.60);
const base2 = shade(deep, 0.80);
const base3 = shade(deep, 1.0);
const light = '#eef3fb';

/* Stable per-slug pick — same article always renders the same art. */
let h = 0;
for (const ch of slug) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const motif = h % 4;
const uid = `bh${(h % 100000).toString(36)}`;
const tilt = (h % 7) - 3;
---

<div class="bha" aria-hidden="true">
  <svg viewBox="0 0 1200 480" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="1200" y2="480" gradientUnits="userSpaceOnUse">
        <stop stop-color={base1}></stop>
        <stop offset="0.55" stop-color={base2}></stop>
        <stop offset="1" stop-color={base3}></stop>
      </linearGradient>
      <radialGradient id={`${uid}-glow`} cx="72%" cy="18%" r="62%">
        <stop offset="0%" stop-color={accent} stop-opacity="0.5"></stop>
        <stop offset="100%" stop-color={accent} stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id={`${uid}-edge`} x1="0" y1="0" x2="0" y2="480" gradientUnits="userSpaceOnUse">
        <stop stop-color={light} stop-opacity="0.9"></stop>
        <stop offset="1" stop-color={sky} stop-opacity="0.4"></stop>
      </linearGradient>
      <pattern id={`${uid}-grid`} width="60" height="60" patternUnits="userSpaceOnUse">
        <path d="M60 0H0V60" fill="none" stroke={sky} stroke-opacity="0.16" stroke-width="1"></path>
      </pattern>
    </defs>

    <rect width="1200" height="480" fill={`url(#${uid}-bg)`}></rect>
    <rect width="1200" height="480" fill={`url(#${uid}-grid)`}></rect>
    <rect width="1200" height="480" fill={`url(#${uid}-glow)`}></rect>

    <g transform={`rotate(${tilt} 600 240)`} opacity="0.95">
      {motif === 0 && (
        <g stroke={`url(#${uid}-edge)`} fill="none">
          <polygon points="600,90 810,240 600,390 390,240" stroke-width="2"></polygon>
          <polygon points="600,140 750,240 600,340 450,240" stroke-width="1.2" stroke-opacity="0.6"></polygon>
          <polygon points="600,190 690,240 600,290 510,240" stroke-width="1" stroke-opacity="0.4"></polygon>
        </g>
      )}
      {motif === 1 && (
        <g fill="none">
          <g stroke={sky} stroke-opacity="0.5" stroke-width="1.2">
            <path d="M240 330 L470 170 L720 300 L960 150"></path>
            <path d="M240 200 L470 170 L720 130 L960 150"></path>
            <path d="M470 170 L520 360 L720 300"></path>
          </g>
          <g fill={light}>
            <circle cx="240" cy="330" r="7"></circle>
            <circle cx="470" cy="170" r="10"></circle>
            <circle cx="720" cy="300" r="8"></circle>
            <circle cx="960" cy="150" r="7"></circle>
            <circle cx="520" cy="360" r="6"></circle>
            <circle cx="240" cy="200" r="5"></circle>
            <circle cx="720" cy="130" r="5"></circle>
          </g>
        </g>
      )}
      {motif === 2 && (
        <g fill="none" stroke-width="1.6">
          <circle cx="600" cy="240" r="150" stroke={sky} stroke-opacity="0.5"></circle>
          <circle cx="600" cy="240" r="104" stroke={accent} stroke-opacity="0.42"></circle>
          <circle cx="600" cy="240" r="58" stroke={light} stroke-opacity="0.5"></circle>
          <path d="M600 60 V420 M420 240 H780" stroke={sky} stroke-opacity="0.28"></path>
        </g>
      )}
      {motif === 3 && (
        <g>
          <g fill={accent} fill-opacity="0.22">
            <rect x="300" y="290" width="86" height="110" rx="6"></rect>
            <rect x="410" y="230" width="86" height="170" rx="6"></rect>
            <rect x="520" y="170" width="86" height="230" rx="6"></rect>
            <rect x="630" y="215" width="86" height="185" rx="6"></rect>
            <rect x="740" y="130" width="86" height="270" rx="6"></rect>
          </g>
          <path d="M343 290 L453 230 L563 170 L673 215 L783 130" fill="none" stroke={light} stroke-opacity="0.7" stroke-width="2"></path>
          <g fill={light}>
            <circle cx="343" cy="290" r="5"></circle>
            <circle cx="453" cy="230" r="5"></circle>
            <circle cx="563" cy="170" r="5"></circle>
            <circle cx="673" cy="215" r="5"></circle>
            <circle cx="783" cy="130" r="5"></circle>
          </g>
        </g>
      )}
    </g>

    <rect y="474" width="1200" height="6" fill={variant === 'overview' ? sky : accent} opacity="0.8"></rect>
  </svg>
</div>

<style>
  .bha { width: 100%; aspect-ratio: 1200 / 480; border-radius: 12px; overflow: hidden; background: #0b1b35; }
  .bha svg { display: block; width: 100%; height: 100%; }
</style>
