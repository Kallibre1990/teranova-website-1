---
/* Cover scene for a blog post: the supplier's own products, staged on a set
   built from that supplier's brand colours.

   Everything here is ours — the scene is drawn in code (docs/IMAGERY.md) and the
   only photographs are the packshots the supplier gave us, cut out by
   scripts/cutout-products.mjs. Nothing pretends to be a photo of a factory, a
   person or a place, so the illustration/evidence line stays intact.

   Without clean cut-outs the caller should fall back to BlogHeroArt. */
interface Props {
  products: string[]; // 1-3 photo paths, most important first
  mode?: 'float' | 'cards'; // cut-outs on a set, or packshots in framed cards
  seed: string; // article slug — keeps the arrangement stable
  deep: string;
  sky: string;
  accent: string;
  bg: string;
  label?: string; // brand name, set quietly into the corner
  eager?: boolean;
}
const { products, mode = 'float', seed, deep, sky, accent, bg, label, eager = false } = Astro.props;

let h = 0;
for (const ch of seed) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const uid = `bc${(h % 1000000).toString(36)}`;
const layout = h % 3; // three stagings, so a supplier's articles do not look alike
const [lead, ...supporting] = products;
---

<div
  class={`bcv bcv--l${layout} bcv--${mode}`}
  style={`--deep:${deep};--sky:${sky};--accent:${accent};--bg:${bg};`}
  aria-hidden="true"
>
  <!-- the set: light field, brand disc, horizon -->
  <div class="bcv__set">
    <span class="bcv__disc"></span>
    <span class="bcv__ring"></span>
    <span class="bcv__halo"></span>
    <span class="bcv__arc"></span>
    <span class="bcv__floor"></span>
  </div>

  {
    mode === 'float' ? (
      /* one shelf line, the lead in front, each with its own contact shadow and
         a short reflection so nothing floats */
      <div class="bcv__stage">
        {[supporting[0], supporting[1], lead].map((src, i) =>
          src ? (
            <div class={`bcv__slot bcv__slot--${['left', 'right', 'lead'][i]}`}>
              <img class="bcv__p" src={src} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
              <img class="bcv__refl" src={src} alt="" aria-hidden="true" loading="lazy" decoding="async" />
              <span class="bcv__contact"></span>
            </div>
          ) : null,
        )}
      </div>
    ) : (
      /* framed cards — the packshot keeps its own white ground, which is exactly
         what saves shots that cannot be cut out */
      <div class="bcv__cards">
        {[supporting[1], supporting[0], lead].map((src) =>
          src ? (
            <figure class="bcv__card">
              <img src={src} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
            </figure>
          ) : null,
        )}
      </div>
    )
  }

  {label && <span class="bcv__label">{label}</span>}

  <!-- grain: keeps the gradients from banding and adds the printed feel -->
  <svg class="bcv__grain" xmlns="http://www.w3.org/2000/svg">
    <filter id={`${uid}-n`}>
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"></feTurbulence>
    </filter>
    <rect width="100%" height="100%" filter={`url(#${uid}-n)`}></rect>
  </svg>
</div>

<style>
  .bcv {
    position: relative;
    width: 100%;
    aspect-ratio: 1200 / 520;
    border-radius: 16px;
    overflow: hidden;
    isolation: isolate;
    container-type: size; /* cqh below = height of this cover */
    background:
      radial-gradient(80% 90% at 88% 78%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%),
      radial-gradient(90% 100% at 8% 6%, #fff 0%, color-mix(in srgb, var(--bg) 88%, #fff) 46%, transparent 74%),
      linear-gradient(126deg, color-mix(in srgb, var(--bg) 82%, #fff) 0%, color-mix(in srgb, var(--sky) 42%, var(--bg)) 52%, color-mix(in srgb, var(--deep) 46%, var(--sky)) 100%);
  }

  /* --- the set ------------------------------------------------------------ */
  .bcv__set { position: absolute; inset: 0; }
  .bcv__set span { position: absolute; display: block; }

  /* The brand disc the products stand against. Muted on purpose: it is a set
     piece, not a poster — a full-strength accent circle fights the packaging. */
  .bcv__disc {
    width: 52%;
    aspect-ratio: 1;
    left: 50%;
    top: 12%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle at 38% 28%, color-mix(in srgb, #fff 62%, var(--sky)), color-mix(in srgb, var(--sky) 78%, var(--deep)));
    opacity: 0.5;
  }
  .bcv--l1 .bcv__disc { left: 36%; top: 6%; width: 48%; }
  .bcv--l2 .bcv__disc { left: 64%; top: 10%; width: 50%; }

  /* A single accent ring — where the brand's sharp colour is allowed to show. */
  .bcv__ring {
    width: 34%;
    aspect-ratio: 1;
    left: -10%;
    top: -18%;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--accent) 55%, transparent);
    opacity: 0.5;
  }
  .bcv--l1 .bcv__ring { left: auto; right: -8%; top: -20%; }
  .bcv--l2 .bcv__ring { left: -12%; top: auto; bottom: -24%; }

  /* soft light pooling behind the lead product */
  .bcv__halo {
    width: 62%;
    aspect-ratio: 1;
    left: 20%;
    top: 4%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, #fff 78%, var(--sky)) 0%, transparent 62%);
    opacity: 0.85;
  }

  /* thin brand arc — the "we connect two sides" motif, kept quiet */
  .bcv__arc {
    width: 78%;
    aspect-ratio: 1;
    left: -14%;
    bottom: -46%;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--deep) 26%, transparent);
    border-bottom-color: transparent;
    border-right-color: transparent;
    transform: rotate(-18deg);
  }

  /* The surface the group stands on — its top edge sits at the shelf line. */
  .bcv__floor {
    inset: auto 0 0 0;
    height: 19%;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--deep) 30%, transparent), color-mix(in srgb, var(--deep) 14%, transparent));
    border-top: 1px solid color-mix(in srgb, #fff 34%, transparent);
  }

  /* --- products ----------------------------------------------------------- */
  /* All three stand on one line (`--shelf`), so the group reads as a staged
     shot rather than three pasted photos. Each slot carries the product, its
     reflection and a contact shadow, and moves as one. */
  /* Sizes are in container height units, so the group scales with the cover
     itself instead of guessing from the viewport. */
  .bcv__stage { position: absolute; inset: 0; --shelf: 19%; }
  .bcv__slot {
    position: absolute;
    bottom: var(--shelf); /* the slot's baseline IS the shelf line */
    transform: translateX(-50%);
  }
  .bcv__p {
    display: block;
    width: auto;
    max-width: none;
    object-fit: contain;
    filter: drop-shadow(0 10px 16px color-mix(in srgb, var(--deep) 34%, transparent));
  }
  /* Mirror image below the line, faded out — the "polished surface" trick. */
  .bcv__refl {
    position: absolute;
    top: 100%;
    left: 50%;
    width: auto;
    max-width: none;
    object-fit: contain;
    transform: translateX(-50%) scaleY(-1);
    opacity: 0.24;
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent 58%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent 58%);
  }
  /* The dark ellipse where the bottle meets the surface. */
  .bcv__contact {
    position: absolute;
    bottom: -2cqh;
    left: 50%;
    transform: translateX(-50%);
    width: 92%;
    height: 4cqh;
    border-radius: 50%;
    background: radial-gradient(ellipse, color-mix(in srgb, var(--deep) 42%, transparent), transparent 72%);
    filter: blur(3px);
  }

  .bcv__slot--lead { left: 50%; z-index: 3; }
  .bcv__slot--lead .bcv__p { height: 70cqh; }
  .bcv__slot--lead .bcv__refl { height: 35cqh; }
  .bcv__slot--left { left: 24%; z-index: 2; }
  .bcv__slot--left .bcv__p { height: 50cqh; }
  .bcv__slot--left .bcv__refl { height: 25cqh; }
  .bcv__slot--right { left: 76%; z-index: 2; }
  .bcv__slot--right .bcv__p { height: 55cqh; }
  .bcv__slot--right .bcv__refl { height: 27cqh; }

  /* Two alternative stagings — same shelf, different centre of gravity. */
  .bcv--l1 .bcv__slot--lead { left: 63%; }
  .bcv--l1 .bcv__slot--left { left: 33%; }
  .bcv--l1 .bcv__slot--right { left: 84%; z-index: 1; }
  .bcv--l2 .bcv__slot--lead { left: 37%; }
  .bcv--l2 .bcv__slot--left { left: 16%; z-index: 1; }
  .bcv--l2 .bcv__slot--right { left: 66%; }

  /* Framed cards ride on a lighter field: several brands have a near-black
     `deep`, and the full-strength gradient turns the cover muddy grey. */
  .bcv--cards {
    background:
      radial-gradient(70% 80% at 84% 76%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 72%),
      radial-gradient(90% 100% at 10% 4%, #fff 0%, color-mix(in srgb, var(--bg) 90%, #fff) 48%, transparent 76%),
      linear-gradient(126deg, color-mix(in srgb, var(--bg) 90%, #fff) 0%, color-mix(in srgb, var(--sky) 28%, var(--bg)) 58%, color-mix(in srgb, var(--sky) 62%, var(--bg)) 100%);
  }

  /* --- framed cards ------------------------------------------------------- */
  .bcv__cards {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3cqw;
    padding: 0 6cqw;
  }
  .bcv__card {
    width: 26cqw;
    max-width: 240px;
    aspect-ratio: 1;
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 18px 40px -12px color-mix(in srgb, var(--deep) 55%, transparent);
    display: grid;
    place-items: center;
    transform: rotate(-3deg);
  }
  .bcv__card:nth-child(2) { transform: rotate(1.5deg) scale(1.12); z-index: 2; }
  .bcv__card:nth-child(3) { transform: rotate(4deg); }
  /* contain, not cover: a packshot cropped mid-bottle looks like a mistake */
  .bcv__card img { width: 100%; height: 100%; object-fit: contain; padding: 6%; }
  /* One card alone looks accidental — let it sit larger and straight. */
  .bcv__card:only-child { width: 40cqw; max-width: 320px; transform: none; }

  /* --- finishing ---------------------------------------------------------- */
  .bcv__label {
    position: absolute;
    left: 4%;
    top: 7%;
    z-index: 4;
    font-size: clamp(0.6rem, 1.05vw, 0.78rem);
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--deep) 78%, #fff);
    opacity: 0.72;
  }
  .bcv--l2 .bcv__label { left: auto; right: 4%; }

  .bcv__grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    opacity: 0.16;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .bcv { aspect-ratio: 4 / 3; }
    .bcv__p--lead { height: 66%; }
    .bcv__p--left { height: 46%; left: 14%; }
    .bcv__p--right { height: 48%; left: 84%; }
  }
</style>
